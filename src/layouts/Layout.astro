---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import SponsorMarquee from '../components/SponsorMarquee.astro';
import CtaSection from '../components/CtaSection.astro';
import NoiseOverlay from '../components/NoiseOverlay.astro';
import RegistrationModal from '../components/RegistrationModal.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  loadLeaflet?: boolean;
  loadChart?: boolean;
  showCta?: boolean;
  showSponsors?: boolean;
  customSchema?: Record<string, any> | Array<Record<string, any>>;
}

const {
  title = "Trail des Mines 2027 - Champagney | Course Nature & Terrils",
  description = "Participez au Trail des Mines à Champagney ! Une course nature exigeante et authentique au cœur des terrils et de la forêt vosgienne.",
  canonical,
  loadLeaflet = false,
  loadChart = false,
  showCta = true,
  showSponsors = true,
  customSchema
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, 'https://traildesmines.fr').href;
---

<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

  <!-- Favicon & Identité Visuelle -->
  <link rel="icon" type="image/png" href="/medias/Logo.png" />
  <link rel="apple-touch-icon" href="/medias/Logo.png" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Trail des Mines" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://traildesmines.fr/medias/Index/Pierre-Coutherut_TDM-2024-2.jpg" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content={title} />
  <meta property="twitter:description" content={description} />
  <meta property="twitter:image" content="https://traildesmines.fr/medias/Index/Pierre-Coutherut_TDM-2024-2.jpg" />

  <!-- Préchargement prioritaire des polices locales (Zéro latence réseau externe, 100% RGPD) -->
  <link rel="preload" href="/fonts/oswald-700-normal-50.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-400-normal-14.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-600-normal-28.woff2" as="font" type="font/woff2" crossorigin />
  
  <!-- FontAwesome 6.4.0 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

  <!-- Données structurées JSON-LD (SEO Rich Results : SportsEvent, Organization, WebSite) -->
  <SchemaOrg customSchema={customSchema} title={title} description={description} url={canonicalURL} />

  <!-- Lenis (Smooth Scroll) & GSAP CDN -->
  <script is:inline src="https://unpkg.com/@studio-freight/lenis@1.0.32/dist/lenis.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>

  <!-- Leaflet CDN (si demandé) -->
  {loadLeaflet && (
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js"></script>
    <script is:inline src="https://unpkg.com/leaflet-omnivore@0.3.4/leaflet-omnivore.min.js"></script>
  )}

  <!-- Chart.js CDN (si demandé) -->
  {loadChart && (
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  )}
</head>

<body class="bg-dark text-white font-sans antialiased overflow-x-hidden selection:bg-brand selection:text-dark relative">
  
  <!-- Lien d'évitement pour l'accessibilité au clavier (WCAG AA/AAA) -->
  <a 
    href="#main-content" 
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-5 focus:py-3 focus:bg-brand focus:text-dark focus:font-display focus:font-bold focus:uppercase focus:tracking-wider focus:rounded-xl focus:shadow-2xl focus:ring-4 focus:ring-dark focus:outline-none"
  >
    Passer au contenu principal
  </a>

  <NoiseOverlay />
  
  <Navbar currentPath={Astro.url.pathname} />

  <!-- Point de repère sémantique HTML5 principal -->
  <main id="main-content" tabindex="-1" class="focus:outline-none min-h-[60vh]">
    <slot />
  </main>

  {showCta && <CtaSection />}

  {showSponsors && <SponsorMarquee />}

  <Footer />

  <RegistrationModal />

  <!-- Script global Lenis, GSAP, Navbar auto-hide & Compteur -->
  <script is:inline src="/js/main.js"></script>
</body>
</html>

---
import Layout from '../layouts/Layout.astro';

const title = "Course Les Terrils 28km / 1380m D+ - Trail des Mines 2027";
const description = "Parcours Les Terrils (28 km, 1380m D+) du Trail des Mines 2027 à Champagney. Tracé technique, trace GPX, ravitaillements, barrières horaires et inscriptions.";
---

<Layout title={title} description={description} loadLeaflet={true} loadChart={true}>

<!-- En-tête Course -->
    <header class="pt-36 md:pt-48 pb-16 px-4 relative overflow-hidden bg-gradient-to-b from-[#0a1214] to-dark">
        <div class="content-70 w-full lg:w-[70%] lg:max-w-none mx-auto text-center relative z-10 gsap-fade-up">
            <span class="inline-block py-1 px-4 rounded-full bg-brand/10 border border-brand/40 text-brand font-display font-bold text-xs uppercase tracking-widest mb-4">Le Format Nerveux & Historique</span>
            <h1 class="font-display text-4xl sm:text-6xl md:text-8xl font-bold uppercase tracking-tight text-white mb-4">
                Les <span class="text-brand">Terrils</span>
            </h1>
            <p class="text-gray-300 max-w-2xl mx-auto text-sm md:text-lg font-light leading-relaxed">
                28 kilomètres de relances impitoyables sur les monticules de schiste minier, les sentiers forestiers et les vestiges des anciens puits d'extraction du bassin de Ronchamp-Champagney.
            </p>
        </div>
    </header>

    <!-- Fiche Technique Clés -->
    <section class="py-8 px-4 content-70 w-full lg:w-[70%] lg:max-w-none mx-auto">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 text-center">
            <div class="bg-cardBg rounded-2xl p-6 border border-brand/30 shadow-[0_0_20px_rgba(176,190,66,0.15)]">
                <span class="text-xs uppercase tracking-widest text-gray-400 block mb-1">Distance</span>
                <span class="font-display text-3xl md:text-4xl font-bold text-white">28 KM</span>
            </div>
            <div class="bg-cardBg rounded-2xl p-6 border border-brand/30 shadow-[0_0_20px_rgba(176,190,66,0.15)]">
                <span class="text-xs uppercase tracking-widest text-gray-400 block mb-1">Dénivelé Positif</span>
                <span class="font-display text-3xl md:text-4xl font-bold text-brand">+1380 M</span>
            </div>
            <div class="bg-cardBg rounded-2xl p-6 border border-brand/30 shadow-[0_0_20px_rgba(176,190,66,0.15)]">
                <span class="text-xs uppercase tracking-widest text-gray-400 block mb-1">Départ</span>
                <span class="font-display text-3xl md:text-4xl font-bold text-white">09h00</span>
                <span class="text-[10px] text-gray-500 block">Champagney Centre</span>
            </div>
            <div class="bg-cardBg rounded-2xl p-6 border border-brand/30 shadow-[0_0_20px_rgba(176,190,66,0.15)]">
                <span class="text-xs uppercase tracking-widest text-gray-400 block mb-1">Participants max</span>
                <span class="font-display text-3xl md:text-4xl font-bold text-white">200</span>
                <span class="text-[10px] text-gray-500 block">ITRA / UTMB Index</span>
            </div>
        </div>
    </section>

    <!-- Carte & Trace GPX avec Courbe de Dénivelé -->
    <section class="py-12 px-4 content-70 w-full lg:w-[70%] lg:max-w-none mx-auto">
        <div class="bg-cardBg rounded-3xl p-6 md:p-8 border border-white/10 shadow-2xl">

            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-white/10 mb-6 relative z-10">
                <div>
                    <h2 class="font-display text-2xl font-bold uppercase text-white">Tracé Officiel & Barrières Horaires</h2>
                    <p class="text-gray-400 text-xs md:text-sm">2 ravitaillements complets (km 12 et km 21). Barrière horaire éliminatoire au km 21 à 13h15.</p>
                </div>
                <div class="flex gap-3">
                    <a href="/medias/Les-Terrils_Gg0RW.gpx" download class="inline-flex items-center gap-2 bg-brand text-dark hover:bg-white px-5 py-2.5 rounded-full font-display uppercase text-xs tracking-wider font-bold transition-all shadow-lg">
                        <i class="fa-solid fa-download"></i>
                        <span>Télécharger GPX</span>
                    </a>
                </div>
            </div>

            <div id="course-map" class="w-full h-[450px] rounded-2xl overflow-hidden relative z-10 border border-white/5"></div>

            <!-- Courbe de Dénivelé (Profil Altimétrique Leaflet/GPX) -->
            <div class="mt-8 pt-6 border-t border-white/10 relative z-10">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                    <div class="flex items-center gap-2.5">
                        <span class="w-2.5 h-2.5 rounded-full bg-[#B0BE42]"></span>
                        <h3 class="font-display text-lg uppercase tracking-wider text-white font-bold">Courbe de dénivelé</h3>
                    </div>
                    <span class="text-xs text-gray-400 font-sans">Distance 28 km • Dénivelé +1380 m / -1380 m</span>
                </div>
                <div class="w-full h-48 md:h-60 bg-dark/60 rounded-xl p-3 md:p-4 border border-white/5 shadow-inner">
                    <canvas id="elevationChart"></canvas>
                </div>
            </div>
        </div>
    </section>

    <!-- Détails Techniques & Sécurité -->
    <section class="py-12 px-4 content-70 w-full lg:w-[70%] lg:max-w-none mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-cardBg rounded-2xl p-8 border border-white/5">
                <h3 class="font-display text-xl font-bold uppercase text-brand mb-4 flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved"></i> Matériel Obligatoire FFA
                </h3>
                <ul class="space-y-3 text-sm text-gray-300">
                    <li class="flex items-start gap-3"><span class="text-brand font-bold">✓</span> Réserve d'eau minimale de 1 litre (poches à eau ou flasques)</li>
                    <li class="flex items-start gap-3"><span class="text-brand font-bold">✓</span> Gobelet réutilisable personnel d'au moins 15cl</li>
                    <li class="flex items-start gap-3"><span class="text-brand font-bold">✓</span> Couverture de survie (1,40m x 2m minimum)</li>
                    <li class="flex items-start gap-3"><span class="text-brand font-bold">✓</span> Sifflet et téléphone chargé avec géolocalisation active</li>
                    <li class="flex items-start gap-3"><span class="text-brand font-bold">✓</span> Veste imperméable coupe-vent avec capuche en cas de météo dégradée</li>
                    <li class="flex items-start gap-3"><span class="text-brand font-bold">✓</span> Barrière horaire : temps limite total de 5h00</li>
                </ul>
            </div>

            <div class="bg-cardBg rounded-2xl p-8 border border-white/5 flex flex-col justify-between">
                <div>
                    <h3 class="font-display text-xl font-bold uppercase text-brand mb-4 flex items-center gap-2">
                        <i class="fa-solid fa-ticket"></i> Inscriptions & Tarifs
                    </h3>
                    <div class="space-y-3 text-sm text-gray-300 mb-6">
                        <div class="flex justify-between pb-2 border-b border-white/10">
                            <span>Tarif Standard (jusqu'au 15 avril)</span>
                            <span class="font-bold text-white">28 €</span>
                        </div>
                        <div class="flex justify-between pb-2 border-b border-white/10">
                            <span>Tarif Tardif (jusqu'au 15 mai)</span>
                            <span class="font-bold text-white">32 €</span>
                        </div>
                        <p class="text-xs text-gray-400">Dotation coureur incluse : maillot technique finisher exclusif, écocup officiel TDM, ravitaillements gourmands du terroir franc-comtois et repas d'après-course.</p>
                    </div>
                </div>
                <a href="/inscription" class="btn-registration-trigger block w-full text-center bg-brand text-dark hover:bg-white py-4 rounded-xl font-display uppercase tracking-widest font-bold transition-all shadow-lg cursor-pointer">
                    Réserver mon dossard Terrils
                </a>
            </div>
        </div>
    </section>

    <!-- Script Leaflet & Courbe Altimétrique GPX -->
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            var mapboxToken = 'pk.eyJ1IjoicGNvdXRoZXJ1dCIsImEiOiJjbThmbWZmdXkwOTV1Mm1zZWV2djNvZjRyIn0.L_LODxZaeDUiRIfJiMd4Fw';
            var map = L.map('course-map', { center: [47.72, 6.70], zoom: 11 });
            L.tileLayer('https://api.mapbox.com/styles/v1/mapbox/outdoors-v12/tiles/{z}/{x}/{y}?access_token=' + mapboxToken, {
                maxZoom: 18,
                attribution: '© Mapbox © OpenStreetMap',
                tileSize: 512,
                zoomOffset: -1
            }).addTo(map);

            new L.GPX('/medias/Les-Terrils_Gg0RW.gpx', {
                async: true,
                polyline_options: { color: '#B0BE42', opacity: 0.95, weight: 5 }
            }).on('loaded', function (e) {
                map.fitBounds(e.target.getBounds(), { padding: [25, 25] });

                var rawElevation = e.target.get_elevation_data();
                if (rawElevation && rawElevation.length > 0 && typeof Chart !== 'undefined') {
                    var chartData = rawElevation.map(function(pt) {
                        return { x: Math.round(pt[0] * 10) / 10, y: Math.round(pt[1]) };
                    });

                    var ctx = document.getElementById('elevationChart').getContext('2d');
                    new Chart(ctx, {
                        type: 'line',
                        data: {
                            datasets: [{
                                label: 'Altitude (m)',
                                data: chartData,
                                borderColor: '#B0BE42',
                                backgroundColor: 'rgba(176, 190, 66, 0.18)',
                                fill: true,
                                tension: 0.15,
                                pointRadius: 0,
                                pointHoverRadius: 5,
                                pointHoverBackgroundColor: '#B0BE42',
                                pointHoverBorderColor: '#ffffff',
                                borderWidth: 2
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        title: function(context) {
                                            return 'Kilomètre ' + context[0].parsed.x + ' km';
                                        },
                                        label: function(context) {
                                            return ' Altitude: ' + context.parsed.y + ' m';
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    type: 'linear',
                                    title: { display: true, text: 'Distance (km)', color: '#9ca3af', font: { size: 11 } },
                                    grid: { color: 'rgba(255,255,255,0.05)' },
                                    ticks: { color: '#9ca3af' }
                                },
                                y: {
                                    title: { display: true, text: 'Altitude (m)', color: '#9ca3af', font: { size: 11 } },
                                    grid: { color: 'rgba(255,255,255,0.05)' },
                                    ticks: { color: '#9ca3af' }
                                }
                            }
                        }
                    });
                }
            }).addTo(map);
        });
    </script>
</Layout>

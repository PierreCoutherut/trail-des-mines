---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import PageHeroBackdrop from '../components/PageHeroBackdrop.astro';
import { CONTACT_SUBJECTS } from '../lib/contacts';

const sent = Astro.url.searchParams.get('sent') === '1';
const failed = Astro.url.searchParams.has('error');
const requestedSubject = Astro.url.searchParams.get('subject') || '';
const selectedSubject = Object.hasOwn(CONTACT_SUBJECTS, requestedSubject) ? requestedSubject : '';
Astro.response.headers.set('Cache-Control', 'no-store');
const fieldClass = 'w-full bg-dark/60 border border-white/20 rounded-xl px-4 py-3.5 text-base text-white placeholder-gray-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand transition-colors';
---

<Layout title="Contact | Trail des Mines — Champagney" description="Une question sur le Trail des Mines ? Contactez l’association Run in Champagney par e-mail ou via le formulaire.">
  <header class="pt-32 pb-14 md:pt-44 md:pb-20 px-4 relative overflow-hidden min-h-[28rem] flex items-end">
    <PageHeroBackdrop src="/medias/Index/Elodie-Bermond_IMG_7330-original.webp" position="50% 42%" />
    <div class="content-70 mx-auto w-full relative z-10">
      <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold uppercase tracking-tight text-white mb-6">Contactez <span class="text-brand">l’organisation</span></h1>
      <p class="text-gray-300 text-base md:text-lg max-w-2xl leading-relaxed">Une question, une envie de participer à l’aventure ou un projet de partenariat ? L’équipe du Trail des Mines vous répond.</p>
    </div>
  </header>
  <div class="content-70 mx-auto px-4 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <section class="lg:col-span-7 bg-cardBg rounded-2xl p-6 sm:p-10" aria-labelledby="contact-form-title">
        <h2 id="contact-form-title" class="font-display text-2xl font-bold uppercase text-white mb-2">Écrivez-nous</h2>
        <p class="text-gray-400 text-sm mb-8">Les champs marqués d’un astérisque sont obligatoires.</p>
        <form id="contact-form" action="/api/contacts" method="post" class="space-y-6">
          <div id="contact-status" role="status" aria-live="polite" tabindex="-1" class:list={['p-4 rounded-xl text-sm leading-relaxed', { hidden: !sent && !failed, 'bg-brand/10 text-brand': sent, 'bg-red-950 text-red-200': failed }]}>
            {sent ? 'Merci ! Votre message a été enregistré. L’équipe vous répondra à l’adresse e-mail indiquée.' : failed ? 'Votre message n’a pas pu être enregistré. Vérifiez les champs puis réessayez, ou contactez-nous par e-mail.' : ''}
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="firstName" class="block text-sm font-semibold text-gray-300 mb-2">Prénom *</label>
              <input id="firstName" name="firstName" autocomplete="given-name" required maxlength="80" class={fieldClass} aria-describedby="firstName-error" />
              <p id="firstName-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
            </div>
            <div>
              <label for="lastName" class="block text-sm font-semibold text-gray-300 mb-2">Nom *</label>
              <input id="lastName" name="lastName" autocomplete="family-name" required maxlength="80" class={fieldClass} aria-describedby="lastName-error" />
              <p id="lastName-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
            </div>
          </div>
          <div>
            <label for="email" class="block text-sm font-semibold text-gray-300 mb-2">Adresse e-mail *</label>
            <input type="email" id="email" name="email" autocomplete="email" required maxlength="254" class={fieldClass} aria-describedby="email-error" />
            <p id="email-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="phone" class="block text-sm font-semibold text-gray-300 mb-2">Téléphone <span class="font-normal text-gray-400">(facultatif)</span></label>
              <input type="tel" id="phone" name="phone" autocomplete="tel" maxlength="40" class={fieldClass} aria-describedby="phone-error" />
              <p id="phone-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
            </div>
            <div>
              <label for="subject" class="block text-sm font-semibold text-gray-300 mb-2">Sujet *</label>
              <select id="subject" name="subject" required class={fieldClass} aria-describedby="subject-error">
                <option value="">Choisissez un sujet</option>
                {Object.entries(CONTACT_SUBJECTS).map(([value, label]) => <option value={value} selected={value === selectedSubject}>{label}</option>)}
              </select>
              <p id="subject-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
            </div>
          </div>
          <div>
            <label for="message" class="block text-sm font-semibold text-gray-300 mb-2">Votre message *</label>
            <textarea id="message" name="message" rows="6" required minlength="10" maxlength="5000" class={`${fieldClass} resize-y`} aria-describedby="message-hint message-error"></textarea>
            <p id="message-hint" class="text-gray-400 text-sm mt-2">Entre 10 et 5 000 caractères.</p>
            <p id="message-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
          </div>
          <div class="hidden" aria-hidden="true">
            <label for="website">Laissez ce champ vide</label><input id="website" name="website" tabindex="-1" autocomplete="off" />
          </div>
          <div>
            <div class="flex items-start gap-3">
              <input type="checkbox" id="consent" name="consent" required class="mt-1 w-5 h-5 shrink-0 accent-brand" aria-describedby="consent-error" />
              <label for="consent" class="text-sm text-gray-300 leading-relaxed">J’accepte que l’association Run in Champagney utilise les informations saisies pour répondre à ma demande, conformément à la <a href="/politique-confidentialite" class="text-brand underline underline-offset-4">politique de confidentialité</a>.</label>
            </div>
            <p id="consent-error" class="field-error text-red-200 text-sm mt-2 hidden"></p>
          </div>
          <button type="submit" id="contact-submit" class="w-full bg-brand text-dark font-display uppercase tracking-wider text-sm py-4 rounded-xl font-bold hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand disabled:opacity-60 disabled:cursor-wait transition-colors">Envoyer mon message</button>
        </form>
      </section>
      <aside class="lg:col-span-5 min-w-0 lg:pt-6">
        <h2 class="font-display text-2xl font-bold uppercase text-white mb-4">En contact direct</h2>
        <p class="text-gray-300 leading-relaxed mb-6">Vous pouvez aussi nous écrire directement par e-mail.</p>
        <a href="mailto:runinchampagney70@gmail.com" class="text-brand text-base sm:text-lg underline underline-offset-4 break-all">runinchampagney70@gmail.com</a>
        <div class="mt-10 pt-8 border-t border-white/10">
          <h3 class="font-display text-lg font-bold uppercase text-white mb-3">Run in Champagney</h3>
          <p class="text-gray-300 leading-relaxed">L’association organisatrice du Trail des Mines, à Champagney en Haute-Saône.</p>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script>
  function initContact() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const button = document.getElementById('contact-submit') as HTMLButtonElement | null;
    const status = document.getElementById('contact-status');
    if (!form || !button || !status || form.dataset.bound) return;
    form.dataset.bound = 'true';
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); if (button.disabled) return;
      form.querySelectorAll('[aria-invalid]').forEach(field => field.removeAttribute('aria-invalid'));
      form.querySelectorAll('.field-error').forEach(field => { field.textContent = ''; field.classList.add('hidden'); });
      status.classList.add('hidden'); button.disabled = true; button.textContent = 'Enregistrement en cours…';
      const controller = new AbortController(); const timeout = window.setTimeout(() => controller.abort(), 20000);
      try {
        const fields = Object.fromEntries(new FormData(form));
        const response = await fetch('/api/contacts', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ ...fields, consent: fields.consent === 'on' }), signal: controller.signal,
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          for (const [name, message] of Object.entries(result.fields || {})) {
            const field = form.elements.namedItem(name) as HTMLElement | null; const error = document.getElementById(`${name}-error`);
            field?.setAttribute('aria-invalid', 'true');
            if (error) { error.textContent = String(message); error.classList.remove('hidden'); }
          }
          throw new Error(result.error || 'Votre message n’a pas été enregistré. Réessayez.');
        }
        form.reset();
        status.textContent = 'Merci ! Votre message a été enregistré. L’équipe vous répondra à l’adresse e-mail indiquée.';
        status.className = 'p-4 rounded-xl bg-brand/10 text-brand text-sm leading-relaxed'; status.focus();
      } catch (error) {
        status.textContent = error instanceof DOMException && error.name === 'AbortError'
          ? 'L’enregistrement prend trop de temps. Votre message est conservé dans le formulaire : réessayez ou écrivez à runinchampagney70@gmail.com.'
          : error instanceof TypeError || error instanceof SyntaxError
            ? 'Connexion impossible. Votre message reste dans le formulaire. Réessayez ou écrivez à runinchampagney70@gmail.com.'
            : error instanceof Error ? error.message : 'Envoi impossible. Réessayez ou contactez-nous par e-mail.';
        status.className = 'p-4 rounded-xl bg-red-950 text-red-200 text-sm leading-relaxed';
        (form.querySelector<HTMLElement>('[aria-invalid="true"]') || status).focus();
      } finally { clearTimeout(timeout); button.disabled = false; button.textContent = 'Envoyer mon message'; }
    });
  }
  initContact(); document.addEventListener('astro:page-load', initContact);
</script>

---
import Layout from '../layouts/Layout.astro';
import PhotoCredit from '../components/PhotoCredit.astro';
import responsiveImages from '../data/responsive-images.json';

const heroImage = responsiveImages.heroes.home;
const courseImage = responsiveImages.heroes.partners;
const sponsorImages = responsiveImages.logos as Record<string, { src: string; srcset: string; width: number; height: number }>;
const sponsorImage = (src: string) => sponsorImages[src.split('/').pop()!];

const title = "Trail des Mines 2027 - Champagney | Course Nature, Terrils & Vosges du Sud";
const description = "Le Trail des Mines revient le 16 mai 2027 à Champagney. On vous prépare quelque chose de spécial : parcours et inscriptions bientôt dévoilés.";

// Données structurées Schema.org pour la vidéo YouTube de l'Aftermovie
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": "Aftermovie Officiel - Trail des Mines 2026",
  "description": "Revivez les moments forts de la 5ème édition du Trail des Mines 2026 à Champagney au cœur des terrils et du massif vosgien.",
  "thumbnailUrl": "https://img.youtube.com/vi/O5vLogBuP20/maxresdefault.jpg",
  "uploadDate": "2026-05-18T12:00:00+02:00",
  "contentUrl": "https://www.youtube.com/watch?v=O5vLogBuP20",
  "embedUrl": "https://www.youtube.com/embed/O5vLogBuP20"
};

// Les 9 sponsors officiels pour le bandeau supérieur (Ligne 1 : 5, Ligne 2 : 4)
const topSponsorsRow1 = [
  { src: '/medias/Sponsors/Sponsor.png', alt: 'Crédit Mutuel - Partenaire Majeur' },
  { src: '/medias/Sponsors/Sponsor (10).jpg', alt: 'Intermarché Champagney' },
  { src: '/medias/Sponsors/Sponsor (4).jpg', alt: 'Département de la Haute-Saône' },
  { src: '/medias/Sponsors/Sponsor (6).jpg', alt: 'Ville de Champagney' },
  { src: '/medias/Sponsors/Sponsor (8).jpg', alt: 'Communauté de Communes Rahin et Chérimont' },
];

const topSponsorsRow2 = [
  { src: '/medias/Sponsors/Sponsor (3).jpg', alt: 'idverde' },
  { src: '/medias/Sponsors/Sponsor (1).jpg', alt: 'Entreprise COTTA' },
  { src: '/medias/Sponsors/Sponsor (9).jpg', alt: 'Transports BASS' },
  { src: '/medias/Sponsors/Sponsor (5).jpg', alt: 'Cryosculpt' },
];

// Images de la galerie avec extraction automatique du nom du photographe (avant le '_')
const galleryImages = [
  { src: '/medias/Index/Pierre-Coutherut_TDM-2024-2.jpg', author: 'Pierre Coutherut', aspect: 'aspect-[4/3]' },
  { src: '/medias/Index/Elodie-Bermond_IMG_6221-original.webp', author: 'Elodie Bermond', aspect: 'aspect-[3/4]' },
  { src: '/medias/Index/Pierre-Coutherut_TDM-2024-231.jpg', author: 'Pierre Coutherut', aspect: 'aspect-square' },
  { src: '/medias/Index/Elodie-Bermond_IMG_7139-original.webp', author: 'Elodie Bermond', aspect: 'aspect-[16/9]' },
  { src: '/medias/Index/Pierre-Coutherut_TDM-2024-343.jpg', author: 'Pierre Coutherut', aspect: 'aspect-[4/3]' },
  { src: '/medias/Index/Elodie-Bermond_IMG_7464-original.webp', author: 'Elodie Bermond', aspect: 'aspect-[3/4]' },
  { src: '/medias/Index/Pierre-Coutherut_Trail-des-mines-2024-2814.jpg', author: 'Pierre Coutherut', aspect: 'aspect-[16/9]' },
  { src: '/medias/Index/Elodie-Bermond_IMG_6698-original.webp', author: 'Elodie Bermond', aspect: 'aspect-[4/3]' }
];
---

<Layout
  title={title}
  description={description}
  loadLeaflet={false}
  loadChart={false}
  showSponsors={false}
  customSchema={videoSchema}
>

    <!-- Hero Section avec H1 SEO & Accessibilité -->
    <header class="min-h-[100svh] relative flex items-center justify-center overflow-hidden w-full img-container" aria-label="En-tête principal">
        <div class="absolute inset-0 z-0 bg-dark">
            <img
              src={heroImage.src}
              srcset={heroImage.srcset}
              sizes="100vw"
              width={heroImage.width}
              height={heroImage.height}
              alt="Coureur en plein effort dans la forêt de Champagney lors du Trail des Mines"
              class="w-full h-full object-cover opacity-60 img-parallax scale-110"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark via-transparent to-transparent"></div>
        </div>

        <!-- H1 Unique SEO Friendly et sémantique -->
        <h1 class="relative z-10 flex flex-col items-center justify-center w-full mt-12">
            <span class="sr-only">Trail des Mines 2027 - 6ème édition, 16 mai 2027 à Champagney</span>
            <span class="font-display text-[15vw] md:text-[12vw] leading-[0.8] uppercase tracking-tighter text-center m-0 text-white hero-anim drop-shadow-2xl block" aria-hidden="true">
                TRAIL DES
            </span>
            <span class="font-display text-[17vw] md:text-[14vw] leading-[0.85] uppercase tracking-tighter text-center m-0 text-brand hero-anim drop-shadow-2xl block" aria-hidden="true">
                MINES
            </span>
        </h1>

        <div class="absolute bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center hero-anim text-center w-full px-4 pointer-events-none">
            <p class="text-[9px] md:text-xs uppercase tracking-[0.2em] md:tracking-[0.4em] mb-4 md:mb-6 text-white/70 font-semibold max-w-xs md:max-w-none drop-shadow-md">
                Champagney, Haute Saône
            </p>
            <div class="w-[1px] h-10 md:h-12 bg-gradient-to-b from-brand to-transparent" aria-hidden="true"></div>
        </div>

        <div class="absolute bottom-6 right-4 md:bottom-8 md:right-8 z-30 hero-anim">
            <a href="#video-section" class="group flex items-center gap-0 md:gap-4 bg-[#101D20]/60 backdrop-blur-lg p-1.5 md:p-2 pr-1.5 md:pr-5 rounded-full md:rounded-[1.5rem] border border-white/10 hover:border-brand/40 hover:bg-[#101D20]/80 transition-all duration-500 shadow-xl shadow-black/50" aria-label="Voir la vidéo aftermovie du trail">
                <div class="w-12 h-12 md:w-20 md:h-20 rounded-full md:rounded-xl overflow-hidden relative border border-white/5 shrink-0">
                    <img src="/medias/Index/Pierre-Coutherut_TDM-2024-2.jpg" alt="" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy">
                    <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
                        <i class="fa-solid fa-play text-white group-hover:text-brand transition-colors text-sm md:text-base ml-0.5" aria-hidden="true"></i>
                    </div>
                </div>
                <span class="hidden md:block font-display uppercase text-[10px] md:text-xs tracking-widest text-white max-w-[120px] leading-tight group-hover:text-brand transition-colors duration-300">
                    Découvrez le trail en vidéo
                </span>
            </a>
        </div>
    </header>

    <!-- Marquee Piloté au scroll -->
    <div class="marquee-section bg-brand text-dark py-3 md:py-5 overflow-hidden border-y border-white/10 relative z-10" aria-hidden="true">
        <div class="flex w-[300vw] md:w-[200vw] marquee-text-gsap select-none">
            <div class="font-display text-2xl md:text-5xl uppercase tracking-widest px-2 md:px-4 whitespace-nowrap">
                16 mai 2027 • 16 mai 2027 • 16 mai 2027 • 16 mai 2027 • 16 mai 2027 • 16 mai 2027 •
            </div>
            <div class="font-display text-2xl md:text-5xl uppercase tracking-widest px-2 md:px-4 whitespace-nowrap">
                16 mai 2027 • 16 mai 2027 • 16 mai 2027 • 16 mai 2027 • 16 mai 2027 • 16 mai 2027 •
            </div>
        </div>
    </div>

    <!-- Bandeau Sponsors sur Fond Blanc (9 logos : 5 en haut, 4 en bas - 70% sur desktop) -->
    <section class="bg-white text-dark py-10 md:py-16 border-b border-gray-200 relative z-10" aria-label="Partenaires et Sponsors officiels">
        <div class="content-70 w-full lg:w-[70%] lg:max-w-none mx-auto px-4 sm:px-6">
            <div class="home-sponsors">
                <!-- Ligne 1 : 5 logos -->
                <div class="home-sponsors-row home-sponsors-row-first">
                    {topSponsorsRow1.map((sp) => (
                        <div class="home-sponsor flex items-center justify-center transition-transform duration-300 hover:scale-105">
                            <img
                                src={sponsorImage(sp.src).src}
                                srcset={sponsorImage(sp.src).srcset}
                                sizes="(max-width: 1023px) 18vw, 12vw"
                                width={sponsorImage(sp.src).width}
                                height={sponsorImage(sp.src).height}
                                decoding="async"
                                alt={sp.alt}
                                class="home-sponsor-image"
                                loading="lazy"
                            />
                        </div>
                    ))}
                </div>

                <!-- Ligne 2 : 4 logos centrés, de même largeur que la première ligne -->
                <div class="home-sponsors-row home-sponsors-row-second">
                    {topSponsorsRow2.map((sp) => (
                        <div class="home-sponsor flex items-center justify-center transition-transform duration-300 hover:scale-105">
                            <img
                                src={sponsorImage(sp.src).src}
                                srcset={sponsorImage(sp.src).srcset}
                                sizes="(max-width: 1023px) 18vw, 12vw"
                                width={sponsorImage(sp.src).width}
                                height={sponsorImage(sp.src).height}
                                decoding="async"
                                alt={sp.alt}
                                class="home-sponsor-image"
                                loading="lazy"
                            />
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Intro Présentation -->
    <section class="py-16 md:py-32 px-4 flex justify-center items-center min-h-[40vh] md:min-h-[50vh] text-center relative overflow-hidden" aria-label="Présentation générale">
        <div class="topo-texture pointer-events-none" aria-hidden="true"></div>
        <div class="content-70 w-full lg:w-[70%] lg:max-w-none gsap-fade-up relative z-10">
            <h2 class="font-display text-2xl sm:text-3xl md:text-5xl font-bold uppercase leading-snug">
                Le Trail des Mines est une course nature organisée par l’association <a href="/a-propos" class="text-brand italic font-medium hover:underline focus-visible:ring-2 focus-visible:ring-brand">Run in Champagney.</a>
                <span class="text-white/90 font-medium block mt-3">La 6<sup class="text-base lowercase">ème</sup> édition se déroulera le <span class="text-brand font-bold">16 mai 2027</span></span>
            </h2>
        </div>
    </section>

    <!-- Les parcours 2027, en attente de leur dévoilement -->
    <section id="parcours-a-venir" class="py-16 md:py-24 bg-cardBg scroll-mt-28" aria-labelledby="courses-heading">
        <div class="content-70 home-courses">
            <div class="home-courses-copy">
                <h2 id="courses-heading" class="font-display font-bold uppercase text-white">Parcours 2027 :<br />à venir</h2>
                <p>Les sentiers gardent encore leurs secrets. Les tracés officiels seront dévoilés très bientôt.</p>
                <p class="home-courses-date">Rendez-vous le 16 mai à Champagney.</p>
                <a href="/parcours" data-open-courses-modal aria-haspopup="dialog" aria-controls="courses-modal" class="home-courses-cta">
                    <span>Découvrir les parcours</span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <figure class="home-courses-photo photo-credit-host relative m-0 overflow-hidden rounded-2xl">
                <img src={courseImage.src} srcset={courseImage.srcset} sizes="(min-width: 1024px) 35vw, (min-width: 768px) 50vw, 100vw" width={courseImage.width} height={courseImage.height} alt="Un coureur sur les sentiers du Trail des Mines à Champagney" class="w-full h-full object-cover" loading="lazy" decoding="async" />
                <PhotoCredit author="Pierre Coutherut" />
            </figure>
        </div>
    </section>

    <!-- Aftermovie et accès aux éditions précédentes -->
    <section id="video-section" class="py-16 md:py-28 bg-dark relative overflow-hidden flex flex-col items-center" aria-labelledby="video-section-heading">

        <div class="text-center mb-8 md:mb-12 relative z-10 w-full px-4 gsap-fade-up">
            <div aria-hidden="true" class="font-display text-[12vw] md:text-[9vw] leading-none font-bold uppercase text-outline-white mix-blend-overlay opacity-20 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full pointer-events-none block select-none">
                AFTERMOVIE
            </div>
            <h2 id="video-section-heading" class="font-display text-3xl md:text-5xl font-bold uppercase relative z-20">
                Revivez l'édition 2026 en vidéo
            </h2>
            <p class="text-gray-400 text-xs sm:text-sm font-sans mt-2 relative z-20 max-w-lg mx-auto">
                L'aftermovie officiel : ambiance festive, paysages miniers et relances nerveuses dans les Vosges du Sud.
            </p>
        </div>

        <div class="content-70 w-full lg:w-[70%] lg:max-w-none mx-auto px-4">
            <div class="video-container w-full aspect-video relative z-20 rounded-2xl md:rounded-[2rem] overflow-hidden gsap-fade-up">
                <button type="button" data-load-aftermovie class="w-full h-full relative flex items-center justify-center bg-cardBg group" aria-label="Regarder la vidéo de l’aftermovie 2026 sur YouTube">
                    <img src="/medias/Index/Pierre-Coutherut_TDM-2024-2.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
                    <span class="relative text-white font-display uppercase text-lg md:text-2xl px-6 py-4 rounded-full bg-dark/90 group-hover:bg-brand group-hover:text-dark transition-colors"><i class="fa-solid fa-play mr-3" aria-hidden="true"></i>Regarder la vidéo</span>
                </button>
            </div>
        </div>
        <p class="text-gray-400 text-xs text-center mt-4 px-4">En lançant la vidéo, vous chargez le lecteur YouTube et acceptez ses <a href="https://policies.google.com/privacy?hl=fr" class="underline underline-offset-4">règles de confidentialité</a>.</p>
        <div class="mt-8 md:mt-10 px-4 text-center gsap-fade-up">
            <a href="/editions-precedentes" class="inline-flex items-center justify-center gap-3 px-7 py-4 rounded-full bg-brand text-dark font-display font-bold uppercase tracking-widest text-xs sm:text-sm hover:bg-white transition-colors">
                <span>Revivez les éditions précédentes</span>
                <i class="fa-solid fa-arrow-right shrink-0" aria-hidden="true"></i>
            </a>
        </div>
    </section>

    <!-- L'association derrière le Trail des Mines -->
    <section id="association" class="py-12 md:py-16" aria-labelledby="association-heading">
        <div class="content-70 mx-auto">
            <div class="home-association bg-cardBg rounded-3xl overflow-hidden gsap-fade-up">
                <figure class="home-association-photo photo-credit-host relative m-0">
                    <img
                        src="/medias/responsive/home-association-1280.webp"
                        srcset="/medias/responsive/home-association-640.webp 640w, /medias/responsive/home-association-960.webp 960w, /medias/responsive/home-association-1280.webp 1280w"
                        sizes="(min-width: 1024px) 29vw, 100vw"
                        width="1280"
                        height="853"
                        alt="Les coureurs réunis sur la ligne de départ du Trail des Mines à Champagney"
                        class="w-full h-full object-cover"
                        loading="lazy"
                        decoding="async"
                    />
                    <PhotoCredit author="Pierre Coutherut" />
                </figure>
                <div class="home-association-copy">
                    <h2 id="association-heading" class="font-display font-bold uppercase text-white">Un évènement organisé par Run in Champagney</h2>
                    <div class="home-association-story text-white">
                        <p><strong>Run’ In Champagney a vu le jour début 2018.</strong></p>
                        <p>L’idée de départ était de créer un groupe pour pratiquer la course à pied et plus particulièrement le Trail.</p>
                        <p>Avec le temps, nous avons réussi à faire parler de notre association notamment grâce à la motivation, la joie et la passion de nos adhérents.</p>
                    </div>
                    <a href="/a-propos" class="home-association-link inline-flex items-center gap-3 text-brand font-semibold hover:text-white transition-colors">
                        <span>Découvrir l’association</span>
                        <i class="fa-solid fa-arrow-right text-sm" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Localisation du départ -->
    <section id="depart" class="pt-16 md:pt-24 w-full" aria-labelledby="depart-heading">
        <div class="departure-content content-70 mx-auto px-4 pb-8 md:pb-12 grid xl:grid-cols-2 gap-8 xl:gap-12 items-end">
          <div>
            <h2 id="depart-heading" class="text-2xl md:text-4xl font-display uppercase font-bold text-white">Le départ à Champagney</h2>
            <p class="mt-4 text-white text-base md:text-lg leading-relaxed">Rendez-vous au gymnase Félix Éboué, impasse du Champ Dia, 70290 Champagney.</p>
          </div>
          <form action="https://www.google.com/maps/dir/" method="get" target="_blank" rel="noopener noreferrer" class="min-w-0">
            <input type="hidden" name="api" value="1" />
            <input type="hidden" name="destination" value="Gymnase Félix Éboué, Impasse du Champ Dia, 70290 Champagney" />
            <input type="hidden" name="travelmode" value="driving" />
            <label for="departure-city" class="block text-white text-base font-semibold mb-3">Votre ville de départ</label>
            <div class="flex flex-col sm:flex-row gap-3">
              <input id="departure-city" name="origin" type="text" autocomplete="address-level2" required maxlength="160" pattern={'.*\\S.*'} title="Saisissez votre ville de départ." placeholder="Ex. : Belfort" aria-describedby="route-help" class="min-w-0 flex-1 bg-white text-dark text-base rounded-xl px-4 py-4 placeholder:text-gray-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand" />
              <button type="submit" class="bg-brand text-dark rounded-xl px-5 py-4 text-base font-semibold hover:bg-white transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand">Calculer l’itinéraire</button>
            </div>
            <p id="route-help" class="mt-3 text-sm text-gray-300">Votre trajet en voiture s’ouvre dans Google Maps, dans un nouvel onglet.</p>
          </form>
        </div>
        <iframe
            title="Carte Google Maps du départ au gymnase Félix Éboué de Champagney"
            src="https://www.google.com/maps?q=Gymnase+F%C3%A9lix+%C3%89bou%C3%A9+Impasse+du+Champ+Dia+70290+Champagney&amp;output=embed"
            class="departure-map block w-full bg-cardBg"
            width="1200"
            height="480"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
        ></iframe>
    </section>

    <!-- Galerie Animée au Scroll (Noir pur pour valoriser les photos - Entête 70% sur desktop) -->
    <section class="py-16 md:py-24 overflow-hidden bg-[#0a1214] galerie-section border-t border-white/5 relative" aria-labelledby="galerie-title">
        <h2 id="galerie-title" class="sr-only">Galerie photographique officielle du Trail des Mines</h2>
        <div class="flex flex-wrap items-center justify-between gap-4 px-4 content-70 w-full lg:w-[70%] lg:max-w-none mx-auto mb-6 md:mb-8 gsap-fade-up relative z-10">
            <div>
                <span class="text-[10px] md:text-xs text-brand font-display tracking-[0.4em] uppercase block">Immersion</span>
                <span class="font-display text-xl md:text-2xl uppercase font-bold text-white">L'Esprit des Terrils en Images</span>
            </div>
            <a href="/resultats-medias" class="text-xs uppercase tracking-widest text-gray-400 hover:text-brand transition-colors font-display inline-flex items-center gap-1.5 group">
                <span>Voir toutes les photos</span>
                <i class="fa-solid fa-arrow-right text-[10px] transition-transform group-hover:translate-x-1" aria-hidden="true"></i>
            </a>
        </div>
        
        <div class="w-[280vw] md:w-[200vw] flex gap-4 md:gap-8 pl-4 pr-4 h-[32vh] md:h-[48vh] galerie-scroll-track relative z-10">
            {galleryImages.map((img) => (
                <div class={`h-full w-auto ${img.aspect} rounded-xl md:rounded-[2rem] overflow-hidden group photo-credit-host relative`}>
                    <img 
                      src={img.src} 
                      alt={`Trail des Mines - Photographie capturée par ${img.author}`} 
                      class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700 cursor-pointer" 
                      loading="lazy" 
                    />
                    
                    <PhotoCredit author={img.author} />
                </div>
            ))}
        </div>
    </section>
    <style>
      .home-sponsors { display: flex; flex-direction: column; align-items: center; gap: clamp(1.5rem, 3vw, 2.75rem); }
      .home-sponsors-row { display: grid; align-items: center; gap: clamp(.5rem, 2vw, 2.75rem); }
      .home-sponsors-row-first { width: 100%; grid-template-columns: repeat(5, minmax(0, 1fr)); }
      .home-sponsors-row-second { width: calc(80% - clamp(.5rem, 2vw, 2.75rem) / 5); grid-template-columns: repeat(4, minmax(0, 1fr)); }
      .home-sponsor { min-width: 0; }
      .home-sponsor-image { display: block; width: 100%; height: clamp(2.5rem, 8vw, 7rem); object-fit: contain; }
      .home-courses { display: grid; align-items: center; gap: 2rem; }
      .home-courses-copy { min-width: 0; width: 100%; max-width: 47rem; }
      .home-courses-copy h2 { font-size: clamp(2rem, 3.8vw, 3.75rem); line-height: 1.1; margin-bottom: 1.5rem; }
      .home-courses-copy p { max-width: 34rem; font-size: 1rem; line-height: 1.7; color: white; }
      .home-courses-copy .home-courses-date { margin-top: 1rem; }
      .home-courses-cta { display: inline-flex; align-items: center; justify-content: space-between; gap: 1.5rem; min-height: 3.5rem; margin-top: 2rem; padding: 1rem 1.5rem; border-radius: .75rem; background: var(--color-brand); color: var(--color-dark); font-weight: 700; font-size: 1rem; transition: background-color .2s; }
      .home-courses-cta:hover { background: white; }
      .home-courses-cta i { transition: transform .2s; }
      .home-courses-cta:hover i { transform: translateX(.25rem); }
      .home-courses-photo { min-width: 0; aspect-ratio: 4 / 3; }
      @media (min-width: 768px) {
        .home-courses { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(2rem, 4vw, 4rem); }
        .home-courses-photo { aspect-ratio: 4 / 5; }
      }
      .home-association { display: grid; }
      .home-association-photo { aspect-ratio: 16 / 9; min-width: 0; }
      .home-association-photo img { display: block; object-position: 50% 45%; }
      .home-association-copy { min-width: 0; padding: clamp(1.5rem, 3vw, 3rem); }
      .home-association-copy h2 { margin: 0 0 1.5rem; font-size: clamp(1.5rem, 2.3vw, 2.25rem); line-height: 1.2; text-wrap: balance; }
      .home-association-story { display: grid; gap: 1rem; font-size: 1rem; line-height: 1.7; }
      .home-association-story p { margin: 0; }
      .home-association-link { min-height: 2.75rem; margin-top: 1.5rem; text-underline-offset: .3em; }
      .home-association-link:hover { text-decoration: underline; }
      @media (min-width: 1024px) {

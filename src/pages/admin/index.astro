        MODALE 4 : CRÉATION / MODIFICATION D'UN ARTICLE DU RÈGLEMENT
        ========================================================================= */}
    <div id="chapter-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
        <div class="bg-cardBg rounded-3xl p-6 sm:p-8 max-w-xl w-full border border-white/10 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">
                <h3 id="chapter-modal-title" class="font-display text-2xl font-bold uppercase text-white">Modifier l'Article</h3>
                <button type="button" class="modal-close-btn text-gray-400 hover:text-white text-2xl p-1" data-modal="chapter-modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="chapter-modal-form" class="space-y-4">
                <input type="hidden" id="modal-chapter-id" value="" />
                <input type="hidden" id="modal-chapter-mode" value="edit" />

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div>
                        <label class="block text-xs uppercase text-gray-400 font-display mb-1">Numéro *</label>
                        <input type="text" id="modal-chapter-number" required placeholder="ex: Article 1" class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand" />
                    </div>
                    <div class="sm:col-span-2">
                        <label class="block text-xs uppercase text-gray-400 font-display mb-1">Titre de l'Article *</label>
                        <input type="text" id="modal-chapter-title" required placeholder="ex: Organisation & Cadre de Course" class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs uppercase text-gray-400 font-display mb-1">Contenu complet *</label>
                    <textarea id="modal-chapter-content" rows="8" required placeholder="Texte de l'article, règles, conditions..." class="w-full bg-dark/80 border border-white/15 rounded-xl p-3.5 text-sm text-white focus:outline-none focus:border-brand leading-relaxed"></textarea>
                    <span class="text-[10px] text-gray-500 font-mono mt-1 block">Astuce : Utilisez des tirets (-) pour créer des listes à puces et des **mots** pour mettre en gras.</span>
                </div>

                <div class="pt-4 flex items-center justify-end gap-3">
                    <button type="button" class="modal-close-btn px-4 py-2.5 rounded-xl text-xs text-gray-400 hover:text-white transition" data-modal="chapter-modal">Annuler</button>
                    <button type="submit" id="modal-chapter-submit-btn" class="bg-brand text-dark font-display font-bold uppercase tracking-wider text-xs px-6 py-2.5 rounded-xl hover:bg-white transition shadow-md">Enregistrer l'Article</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Conteneur de Notifications Toasts Flottantes -->
    <div id="admin-toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2.5 max-w-sm pointer-events-none"></div>

</Layout>

<script>
    function initAdmin() {
        
        // ==========================================
        // 0. Système de Toasts Modernes & Utilitaires
        // ==========================================
        function showToast(message: string, type: 'success' | 'error' | 'info' = 'success') {
            const container = document.getElementById('admin-toast-container');
            if (!container) {
                alert(message);
                return;
            }
            const toast = document.createElement('div');
            const bgClass = type === 'error'
                ? 'bg-red-950/90 border-red-500/50 text-red-200'
                : type === 'info'
                ? 'bg-blue-950/90 border-blue-500/50 text-blue-200'
                : 'bg-dark/95 border-brand/50 text-white shadow-brand/10';
            const icon = type === 'error' ? 'fa-circle-exclamation text-red-400' : type === 'info' ? 'fa-circle-info text-blue-400' : 'fa-circle-check text-brand';

            toast.className = `p-4 rounded-2xl text-xs font-semibold shadow-2xl flex items-center gap-3 pointer-events-auto border backdrop-blur-xl transition-all duration-300 transform translate-y-2 opacity-0 ${bgClass}`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-base shrink-0"></i><span class="flex-1 leading-snug">${message}</span>`;
            
            container.appendChild(toast);
            requestAnimationFrame(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            });

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function openModal(modalId: string) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.classList.remove('hidden');
            setTimeout(() => modal.classList.remove('opacity-0'), 10);
        }

        function closeModal(modalId: string) {
            const modal = document.getElementById(modalId);
            if (!modal) return;
            modal.classList.add('opacity-0');
            setTimeout(() => modal.classList.add('hidden'), 300);
        }

        // Fermeture générique des modales
        document.querySelectorAll('.modal-close-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const modalId = btn.getAttribute('data-modal');
                if (modalId) closeModal(modalId);
            });
        });

        // Fermeture sur clic en dehors de la boîte modale & touche Échap
        ['edition-modal', 'race-modal', 'photographer-modal', 'chapter-modal'].forEach(id => {
            const modal = document.getElementById(id);
            if (modal) {
                modal.addEventListener('click', (e) => {
                    if (e.target === modal) closeModal(id);
                });
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') {
                ['edition-modal', 'race-modal', 'photographer-modal', 'chapter-modal'].forEach(closeModal);
            }
        });

        // ==========================================
        // 1. Formulaire de Connexion
        // ==========================================
        const loginForm = document.getElementById('login-form') as HTMLFormElement | null;
        if (loginForm) {
            loginForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const usernameInput = document.getElementById('login-username') as HTMLInputElement;
                const passwordInput = document.getElementById('login-password') as HTMLInputElement;
                const errBox = document.getElementById('login-error');
                const submitBtn = document.getElementById('login-submit-btn');

                if (submitBtn) submitBtn.setAttribute('disabled', 'true');
                if (errBox) errBox.classList.add('hidden');

                try {
                    const res = await fetch('/api/auth', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            username: usernameInput.value,
                            password: passwordInput.value
                        })
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        if (errBox) {
                            errBox.textContent = data.error || 'Identifiants invalides';
                            errBox.classList.remove('hidden');
                        }
                        if (submitBtn) submitBtn.removeAttribute('disabled');
                    } else {
                        showToast('Connexion réussie ! Chargement...', 'success');
                        setTimeout(() => window.location.reload(), 500);
                    }
                } catch (err: any) {
                    if (errBox) {
                        errBox.textContent = err.message || 'Erreur réseau';
                        errBox.classList.remove('hidden');
                    }
                    if (submitBtn) submitBtn.removeAttribute('disabled');
                }
            });
        }

        // ==========================================
        // 2. Déconnexion
        // ==========================================
        const logoutBtn = document.getElementById('logout-btn');
        if (logoutBtn) {
            logoutBtn.addEventListener('click', async () => {
                await fetch('/api/auth', { method: 'DELETE' });
                window.location.reload();
            });
        }

        // ==========================================
        // 3. Navigation par Onglets Principaux avec Persistance
        // ==========================================
        const tabBtns = document.querySelectorAll('.admin-tab-btn');
        const tabPanels = document.querySelectorAll('.tab-panel');

        function switchTab(targetTab: string) {
            tabBtns.forEach(b => {
                const isTarget = b.getAttribute('data-tab') === targetTab;
                if (isTarget) {
                    b.classList.add('bg-brand', 'text-dark', 'shadow');
                    b.classList.remove('bg-transparent', 'text-gray-300');
                } else {
                    b.classList.remove('bg-brand', 'text-dark', 'shadow');
                    b.classList.add('bg-transparent', 'text-gray-300');
                }
            });

            tabPanels.forEach(p => p.classList.add('hidden'));
            const activePanel = document.getElementById(`tab-panel-${targetTab}`);
            if (activePanel) activePanel.classList.remove('hidden');

            try {
                localStorage.setItem('admin_active_tab', targetTab);
                history.replaceState(null, '', `#${targetTab}`);
            } catch (e) {}
        }

        tabBtns.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetTab = btn.getAttribute('data-tab');
                if (targetTab) switchTab(targetTab);
            });
        });

        // Restaurer automatiquement l'onglet actif au chargement
        const hashTab = window.location.hash.replace('#', '');
        const savedTab = hashTab || localStorage.getItem('admin_active_tab') || 'editions';
        if (document.getElementById(`tab-panel-${savedTab}`)) {
            switchTab(savedTab);
        }

        // ==========================================
        // 4. Gestion des Éditions (Créer & MODIFIER)
        // ==========================================
        const openNewEdBtn = document.getElementById('open-new-edition-btn');
        const edModalForm = document.getElementById('edition-modal-form') as HTMLFormElement | null;
        const edModalTitle = document.getElementById('edition-modal-title');
        const edModeInput = document.getElementById('modal-ed-mode') as HTMLInputElement | null;
        const edYearInput = document.getElementById('modal-ed-year') as HTMLInputElement | null;
        const edTitleInput = document.getElementById('modal-ed-title') as HTMLInputElement | null;
        const edSubtitleInput = document.getElementById('modal-ed-subtitle') as HTMLInputElement | null;
        const edDateInput = document.getElementById('modal-ed-date') as HTMLInputElement | null;
        const edDescInput = document.getElementById('modal-ed-desc') as HTMLTextAreaElement | null;
        const edHighlightsInput = document.getElementById('modal-ed-highlights') as HTMLTextAreaElement | null;
        const edFinishersInput = document.getElementById('modal-ed-finishers') as HTMLInputElement | null;
        const edRunnersInput = document.getElementById('modal-ed-runners') as HTMLInputElement | null;
        const edVolunteersInput = document.getElementById('modal-ed-volunteers') as HTMLInputElement | null;
        const edWeatherInput = document.getElementById('modal-ed-weather') as HTMLInputElement | null;
        const edRecHolderInput = document.getElementById('modal-ed-record-holder') as HTMLInputElement | null;
        const edRecTimeInput = document.getElementById('modal-ed-record-time') as HTMLInputElement | null;
        const edExistingPosterInput = document.getElementById('modal-ed-existing-poster') as HTMLInputElement | null;
        const edPosterPreviewContainer = document.getElementById('modal-ed-poster-preview-container');
        const edPosterPreview = document.getElementById('modal-ed-poster-preview') as HTMLImageElement | null;
        const edPosterFileInput = document.getElementById('modal-ed-poster-file') as HTMLInputElement | null;
        const edSubmitBtn = document.getElementById('modal-ed-submit-btn');

        if (openNewEdBtn) {
            openNewEdBtn.addEventListener('click', () => {
                if (edModalForm) edModalForm.reset();
                if (edModeInput) edModeInput.value = 'create';
                if (edYearInput) {
                    edYearInput.removeAttribute('readonly');
                    edYearInput.classList.remove('opacity-60', 'cursor-not-allowed');
                }
                if (edModalTitle) edModalTitle.textContent = 'Créer une Édition';
                if (edExistingPosterInput) edExistingPosterInput.value = '';
                if (edPosterPreviewContainer) edPosterPreviewContainer.classList.add('hidden');
                openModal('edition-modal');
            });
        }

        // Brancher les boutons Modifier sur les cartes d'éditions
        document.querySelectorAll('.edit-edition-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const edDataRaw = btn.getAttribute('data-edition');
                if (!edDataRaw) return;
                try {
                    const ed = JSON.parse(edDataRaw);
                    if (edModalForm) edModalForm.reset();

                    if (edModeInput) edModeInput.value = 'edit';
                    if (edModalTitle) edModalTitle.textContent = `Modifier l'Édition ${ed.year}`;
                    
                    if (edYearInput) {
                        edYearInput.value = String(ed.year);
                        edYearInput.setAttribute('readonly', 'true');
                        edYearInput.classList.add('opacity-60', 'cursor-not-allowed');
                    }
                    if (edTitleInput) edTitleInput.value = ed.title || '';
                    if (edSubtitleInput) edSubtitleInput.value = ed.subtitle || '';
                    if (edDateInput) edDateInput.value = ed.date || '';
                    if (edDescInput) edDescInput.value = ed.description || '';
                    if (edHighlightsInput) edHighlightsInput.value = Array.isArray(ed.highlights) ? ed.highlights.join('\n') : '';

                    if (edFinishersInput) edFinishersInput.value = String(ed.stats?.finishers || '');
                    if (edRunnersInput) edRunnersInput.value = String(ed.stats?.runners || '');
                    if (edVolunteersInput) edVolunteersInput.value = String(ed.stats?.volunteers || '');
                    if (edWeatherInput) edWeatherInput.value = ed.stats?.weather || '';
                    if (edRecHolderInput) edRecHolderInput.value = ed.stats?.recordHolder || '';
                    if (edRecTimeInput) edRecTimeInput.value = ed.stats?.recordTime || '';

                    if (edExistingPosterInput) edExistingPosterInput.value = ed.posterUrl || '';
                    if (edPosterPreview && ed.posterUrl) {
                        edPosterPreview.src = ed.posterUrl;
                        if (edPosterPreviewContainer) edPosterPreviewContainer.classList.remove('hidden');
                    } else if (edPosterPreviewContainer) {
                        edPosterPreviewContainer.classList.add('hidden');
                    }

                    openModal('edition-modal');
                } catch (e) {
                    console.error('Erreur parsing edition:', e);
                }
            });
        });

        if (edModalForm) {
            edModalForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (edSubmitBtn) edSubmitBtn.setAttribute('disabled', 'true');

                try {
                    const year = parseInt(edYearInput?.value || '0', 10);
                    const title = edTitleInput?.value || '';
                    const subtitle = edSubtitleInput?.value || `${year} • Trail des Mines`;
                    const date = edDateInput?.value || `Mai ${year}`;
                    const desc = edDescInput?.value || '';
                    const rawHighlights = edHighlightsInput?.value || '';
                    const highlights = rawHighlights.split('\n').map(h => h.trim()).filter(Boolean);

                    const finishers = parseInt(edFinishersInput?.value || '0', 10);
                    const runners = parseInt(edRunnersInput?.value || '0', 10);
                    const volunteers = parseInt(edVolunteersInput?.value || '0', 10);
                    const weather = edWeatherInput?.value || '';
                    const recordHolder = edRecHolderInput?.value || '';
                    const recordTime = edRecTimeInput?.value || '';

                    let posterUrl = edExistingPosterInput?.value || `/medias/affiches/affiche-${year}.webp`;

                    // Si un fichier d'affiche est sélectionné, upload préalable
                    if (edPosterFileInput && edPosterFileInput.files && edPosterFileInput.files[0]) {
                        const posterFormData = new FormData();
                        posterFormData.append('type', 'poster');
                        posterFormData.append('editionYear', String(year));
                        posterFormData.append('file', edPosterFileInput.files[0]);

                        const pRes = await fetch('/api/upload', {
                            method: 'POST',
                            body: posterFormData
                        });
                        const pData = await pRes.json();
                        if (pData.posterUrl) {
                            posterUrl = pData.posterUrl;
                        }
                    }

                    const edPayload = {
                        year,
                        title,
                        subtitle,
                        date,
                        description: desc,
                        posterUrl,
                        highlights,
                        stats: {
                            finishers,
                            runners,
                            volunteers,
                            weather,
                            recordHolder,
                            recordTime
                        }
                    };

                    const res = await fetch('/api/editions', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(edPayload)
                    });

                    const data = await res.json();
                    if (res.ok && data.success) {
                        showToast(`Édition ${year} enregistrée avec succès !`, 'success');
                        closeModal('edition-modal');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        showToast(data.error || 'Erreur lors de la sauvegarde', 'error');
                        if (edSubmitBtn) edSubmitBtn.removeAttribute('disabled');
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                    if (edSubmitBtn) edSubmitBtn.removeAttribute('disabled');
                }
            });
        }

        // Suppression d'une édition
        document.querySelectorAll('.delete-edition-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const year = btn.getAttribute('data-year');
                if (!confirm(`Supprimer définitivement l'édition ${year} ainsi que toutes ses courses et galeries ?`)) return;

                try {
                    const res = await fetch(`/api/editions?id=${year}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        showToast(`Édition ${year} supprimée avec succès`, 'success');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        showToast(data.error || 'Erreur lors de la suppression', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur réseau : ' + err.message, 'error');
                }
            });
        });

        // ==========================================
        // 5. Gestion des Liens de Résultats (Onglet 2)
        // ==========================================
        const resultsYearTabs = document.querySelectorAll('.results-year-btn');
        let currentSelectedResultsYear = resultsYearTabs[0]?.getAttribute('data-year') || '2025';

        function selectResultsYear(year: string) {
            currentSelectedResultsYear = year;
            resultsYearTabs.forEach(t => {
                if (t.getAttribute('data-year') === year) {
                    t.classList.add('bg-brand', 'text-dark', 'shadow');
                    t.classList.remove('bg-cardBg', 'text-gray-300');
                } else {
                    t.classList.remove('bg-brand', 'text-dark', 'shadow');
                    t.classList.add('bg-cardBg', 'text-gray-300');
                }
            });

            document.querySelectorAll('.results-year-container').forEach(c => c.classList.add('hidden'));
            const targetContainer = document.getElementById(`results-year-${year}`);
            if (targetContainer) targetContainer.classList.remove('hidden');
        }

        resultsYearTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const year = tab.getAttribute('data-year');
                if (year) selectResultsYear(year);
            });
        });

        // Bouton de raccourci depuis Tab 1 : "Gérer les résultats"
        document.querySelectorAll('.jump-to-results-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const year = btn.getAttribute('data-year');
                switchTab('resultats');
                if (year) selectResultsYear(year);
            });
        });

        // Helper pour renuméroter les lignes d'une année
        function reindexResultLinkRows(year: string) {
            const listEl = document.getElementById(`result-links-list-${year}`);
            if (!listEl) return;
            const rows = listEl.querySelectorAll<HTMLElement>('.result-link-row');
            rows.forEach((row, idx) => {
                const badge = row.querySelector('.link-row-index');
                if (badge) badge.textContent = `#${idx + 1}`;
            });

            // Gérer le conteneur vide
            const emptyNotice = listEl.querySelector('.empty-links-notice');
            if (rows.length === 0) {
                if (!emptyNotice) {
                    const notice = document.createElement('div');
                    notice.className = 'empty-links-notice bg-dark/40 rounded-2xl p-8 text-center border border-dashed border-white/15';
                    notice.innerHTML = `
                        <i class="fa-solid fa-trophy text-3xl text-gray-500 mb-3 block"></i>
                        <p class="text-gray-400 text-sm mb-4">Aucun lien de résultat configuré pour l'édition ${year}.</p>
                        <button type="button" class="add-result-link-row-btn bg-brand text-dark text-xs px-4 py-2 rounded-xl font-bold uppercase font-display tracking-wider" data-year="${year}">
                            <i class="fa-solid fa-plus mr-1"></i> Ajouter un premier lien
                        </button>
                    `;
                    listEl.appendChild(notice);
                    notice.querySelector('.add-result-link-row-btn')?.addEventListener('click', () => addResultLinkRow(year));
                }
            } else if (emptyNotice) {
                emptyNotice.remove();
            }
        }

        // Créer une nouvelle ligne de lien
        function createLinkRowElement(year: string, label = '', url = '') {
            const row = document.createElement('div');
            row.className = 'result-link-row bg-dark/60 rounded-2xl p-4 border border-white/10 hover:border-brand/40 transition flex flex-col md:flex-row items-stretch md:items-center gap-3 animate-fade-in';
            row.innerHTML = `
                <div class="link-row-index w-8 h-8 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-mono font-bold text-xs shrink-0 self-start md:self-auto">
                    #
                </div>
                <div class="flex-1">
                    <label class="block text-[10px] uppercase text-gray-400 font-display mb-1">Intitulé du résultat *</label>
                    <input 
                      type="text" 
                      class="link-label-input w-full bg-dark/90 border border-white/15 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-brand" 
                      value="${label.replace(/"/g, '&quot;')}" 
                      placeholder="ex: Classement 52 km - ChronoStart" 
                      required 
                    />
                </div>
                <div class="flex-[1.5]">
                    <label class="block text-[10px] uppercase text-gray-400 font-display mb-1">Lien externe (URL complète) *</label>
                    <input 
                      type="url" 
                      class="link-url-input w-full bg-dark/90 border border-white/15 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-brand font-mono text-xs" 
                      value="${url.replace(/"/g, '&quot;')}" 
                      placeholder="https://www.chrono-start.com/..." 
                      required 
                    />
                </div>
                <div class="flex items-center gap-2 pt-2 md:pt-4 self-end md:self-auto shrink-0">
                    <a 
                      href="${url || '#'}" 
                      target="_blank" 
                      rel="noopener noreferrer" 
                      class="test-link-btn px-3 py-2 bg-white/5 hover:bg-brand/20 text-gray-300 hover:text-brand rounded-xl border border-white/10 text-xs font-medium transition inline-flex items-center gap-1.5 ${url ? '' : 'opacity-40 pointer-events-none'}"
                      title="Tester le lien"
                    >
                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                        <span class="hidden sm:inline">Tester</span>
                    </a>
                    <button 
                      type="button" 
                      class="delete-link-row-btn px-3 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl text-xs font-medium transition inline-flex items-center gap-1.5"
                      title="Supprimer cette ligne"
                    >
                        <i class="fa-solid fa-trash text-[11px]"></i>
                        <span class="hidden sm:inline">Supprimer</span>
                    </button>
                </div>
            `;

            // Événements pour cette ligne
            const urlInput = row.querySelector('.link-url-input') as HTMLInputElement;
            const testBtn = row.querySelector('.test-link-btn') as HTMLAnchorElement;
            const deleteBtn = row.querySelector('.delete-link-row-btn') as HTMLButtonElement;

            urlInput.addEventListener('input', () => {
                const val = urlInput.value.trim();
                testBtn.href = val || '#';
                if (val && (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))) {
                    testBtn.classList.remove('opacity-40', 'pointer-events-none');
                } else {
                    testBtn.classList.add('opacity-40', 'pointer-events-none');
                }
            });

            deleteBtn.addEventListener('click', () => {
                row.remove();
                reindexResultLinkRows(year);
            });

            return row;
        }

        function addResultLinkRow(year: string, label = '', url = '') {
            const listEl = document.getElementById(`result-links-list-${year}`);
            if (!listEl) return;
            const row = createLinkRowElement(year, label, url);
            listEl.appendChild(row);
            reindexResultLinkRows(year);
            const labelInput = row.querySelector('.link-label-input') as HTMLInputElement;
            if (labelInput) labelInput.focus();
        }

        // Brancher les boutons d'ajout déjà présents
        document.querySelectorAll('.add-result-link-row-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const y = btn.getAttribute('data-year');
                if (y) addResultLinkRow(y);
            });
        });

        // Brancher les lignes déjà rendues côté serveur
        document.querySelectorAll('.results-year-container').forEach(container => {
            const year = container.getAttribute('data-year') || '';
            const listEl = container.querySelector('.result-links-list');
            if (!listEl) return;

            listEl.querySelectorAll('.result-link-row').forEach(row => {
                const urlInput = row.querySelector('.link-url-input') as HTMLInputElement;
                const testBtn = row.querySelector('.test-link-btn') as HTMLAnchorElement;
                const deleteBtn = row.querySelector('.delete-link-row-btn') as HTMLButtonElement;

                if (urlInput && testBtn) {
                    urlInput.addEventListener('input', () => {
                        const val = urlInput.value.trim();
                        testBtn.href = val || '#';
                        if (val && (val.startsWith('http://') || val.startsWith('https://') || val.startsWith('/'))) {
                            testBtn.classList.remove('opacity-40', 'pointer-events-none');
                        } else {
                            testBtn.classList.add('opacity-40', 'pointer-events-none');
                        }
                    });
                }

                if (deleteBtn) {
                    deleteBtn.addEventListener('click', () => {
                        row.remove();
                        if (year) reindexResultLinkRows(year);
                    });
                }
            });
        });

        // Enregistrement des liens d'une édition
        document.querySelectorAll('.save-year-results-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const year = btn.getAttribute('data-year');
                if (!year) return;

                const listEl = document.getElementById(`result-links-list-${year}`);
                if (!listEl) return;

                const rows = listEl.querySelectorAll('.result-link-row');
                const links: { label: string; url: string }[] = [];
                let hasIncomplete = false;

                rows.forEach(row => {
                    const labelInput = row.querySelector('.link-label-input') as HTMLInputElement;
                    const urlInput = row.querySelector('.link-url-input') as HTMLInputElement;
                    const label = (labelInput?.value || '').trim();
                    const url = (urlInput?.value || '').trim();

                    if (label && url) {
                        links.push({ label, url });
                    } else if (label || url) {
                        hasIncomplete = true;
                    }
                });

                if (hasIncomplete) {
                    showToast('Veuillez renseigner à la fois le label et l\'URL pour chaque ligne (ou supprimez la ligne vide).', 'error');
                    return;
                }

                const originalBtnText = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Enregistrement...</span>';
                btn.setAttribute('disabled', 'true');

                try {
                    const res = await fetch('/api/edition-result-links', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ year, resultLinks: links })
                    });

                    const data = await res.json();
                    if (res.ok && data.success) {
                        showToast(`Liens de l'édition ${year} enregistrés (${links.length} lien(s)) !`, 'success');
                        // Mettre à jour les badges de compteur
                        const yearTabBtn = document.querySelector(`.results-year-btn[data-year="${year}"] span:last-child`);
                        if (yearTabBtn) yearTabBtn.textContent = String(links.length);
                        const edCardBtn = document.querySelector(`.jump-to-results-btn[data-year="${year}"] span`);
                        if (edCardBtn) edCardBtn.textContent = `Résultats (${links.length})`;
                        reindexResultLinkRows(year);
                    } else {
                        showToast(data.error || 'Erreur lors de l\'enregistrement', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur réseau : ' + err.message, 'error');
                } finally {
                    btn.innerHTML = originalBtnText;
                    btn.removeAttribute('disabled');
                }
            });
        });

        // ==========================================
        // 6. Gestion des Galeries & Photos (Onglet 4)
        // ==========================================
        const galleryYearTabs = document.querySelectorAll('.galleries-year-btn');
        let currentSelectedGalleryYear = galleryYearTabs[0]?.getAttribute('data-year') || '';

        galleryYearTabs.forEach(tab => {
            tab.addEventListener('click', () => {
                const year = tab.getAttribute('data-year');
                if (!year) return;
                currentSelectedGalleryYear = year;

                galleryYearTabs.forEach(t => {
                    t.classList.remove('bg-brand', 'text-dark', 'shadow');
                    t.classList.add('bg-cardBg', 'text-gray-300');
                });
                tab.classList.add('bg-brand', 'text-dark', 'shadow');
                tab.classList.remove('bg-cardBg', 'text-gray-300');

                document.querySelectorAll('.galleries-year-container').forEach(c => c.classList.add('hidden'));
                const targetContainer = document.getElementById(`galleries-year-${year}`);
                if (targetContainer) targetContainer.classList.remove('hidden');
            });
        });

        // Déplier les photos d'une sous-galerie
        document.querySelectorAll('.toggle-photos-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-target');
                if (!targetId) return;
                const el = document.getElementById(targetId);
                if (el) {
                    el.classList.toggle('hidden');
                    const isNowHidden = el.classList.contains('hidden');
                    const icon = btn.querySelector('i');
                    if (icon) {
                        icon.className = isNowHidden ? 'fa-solid fa-chevron-down text-[10px] ml-1' : 'fa-solid fa-chevron-up text-[10px] ml-1';
                    }
                }
            });
        });

        // Supprimer une photo individuelle
        document.querySelectorAll('.delete-single-photo-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
                e.stopPropagation();
                const year = btn.getAttribute('data-year');
                const slug = btn.getAttribute('data-slug');
                const photoId = btn.getAttribute('data-photo-id');
                if (!year || !slug || !photoId) return;

                if (!confirm('Supprimer définitivement ce cliché ?')) return;

                try {
                    const res = await fetch(`/api/galleries?editionYear=${year}&photographerSlug=${slug}&photoId=${photoId}`, {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        const card = document.getElementById(`photo-card-${photoId}`);
                        if (card) {
                            card.style.opacity = '0';
                            setTimeout(() => card.remove(), 300);
                        }
                        showToast('Photo supprimée avec succès', 'success');
                    } else {
                        showToast(data.error || 'Erreur lors de la suppression', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                }
            });
        });

        // Modale Photographe (Créer & Modifier)
        const openNewPhotographerBtn = document.getElementById('open-new-photographer-btn');
        const photoModalForm = document.getElementById('photographer-modal-form') as HTMLFormElement | null;
        const photoModalTitle = document.getElementById('photo-modal-title');
        const photoModalYear = document.getElementById('modal-photo-year') as HTMLInputElement | null;
        const photoModalSlug = document.getElementById('modal-photo-slug') as HTMLInputElement | null;
        const photoModalName = document.getElementById('modal-photo-name') as HTMLInputElement | null;
        const photoModalBio = document.getElementById('modal-photo-bio') as HTMLTextAreaElement | null;
        const photoModalIg = document.getElementById('modal-photo-instagram') as HTMLInputElement | null;
        const photoModalWeb = document.getElementById('modal-photo-website') as HTMLInputElement | null;

        if (openNewPhotographerBtn) {
            openNewPhotographerBtn.addEventListener('click', () => {
                if (photoModalForm) photoModalForm.reset();
                if (photoModalTitle) photoModalTitle.textContent = 'Nouveau Photographe';
                if (photoModalYear) photoModalYear.value = currentSelectedGalleryYear || '2025';
                if (photoModalSlug) photoModalSlug.value = '';
                openModal('photographer-modal');
            });
        }

        document.querySelectorAll('.edit-photographer-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const raw = btn.getAttribute('data-photographer');
                const year = btn.getAttribute('data-year');
                if (!raw || !year) return;

                try {
                    const g = JSON.parse(raw);
                    if (photoModalForm) photoModalForm.reset();
                    if (photoModalTitle) photoModalTitle.textContent = `Modifier ${g.photographerName}`;
                    if (photoModalYear) photoModalYear.value = year;
                    if (photoModalSlug) photoModalSlug.value = g.photographerSlug;
                    if (photoModalName) photoModalName.value = g.photographerName || '';
                    if (photoModalBio) photoModalBio.value = g.bio || '';
                    if (photoModalIg) photoModalIg.value = g.instagramUrl || '';
                    if (photoModalWeb) photoModalWeb.value = g.websiteUrl || '';

                    openModal('photographer-modal');
                } catch (e) {
                    console.error('Erreur parsing photographe:', e);
                }
            });
        });

        if (photoModalForm) {
            photoModalForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                try {
                    const payload = {
                        editionYear: photoModalYear?.value,
                        photographerSlug: photoModalSlug?.value,
                        photographerName: photoModalName?.value,
                        bio: photoModalBio?.value,
                        instagramUrl: photoModalIg?.value,
                        websiteUrl: photoModalWeb?.value
                    };

                    const res = await fetch('/api/galleries', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const data = await res.json();
                    if (res.ok && data.success) {
                        showToast('Profil photographe enregistré !', 'success');
                        closeModal('photographer-modal');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        showToast(data.error || 'Erreur enregistrement', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                }
            });
        }

        // Supprimer photographe entier
        document.querySelectorAll('.delete-photographer-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const slug = btn.getAttribute('data-slug');
                const name = btn.getAttribute('data-name');
                const year = btn.getAttribute('data-year');
                if (!slug || !year) return;

                if (!confirm(`Supprimer l'album complet de ${name} pour l'édition ${year} ainsi que toutes ses photos ?`)) return;

                try {
                    const res = await fetch(`/api/galleries?editionYear=${year}&photographerSlug=${slug}`, {
                        method: 'DELETE'
                    });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        showToast('Photographe et galerie supprimés', 'success');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        showToast(data.error || 'Erreur lors de la suppression', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                }
            });
        });

        // ==========================================
        // 7. Studio d'Upload & Traitement d'Images
        // ==========================================
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('upload-files') as HTMLInputElement | null;
        const previewsContainer = document.getElementById('file-previews');
        const filesList = document.getElementById('files-list');
        const filesCountBadge = document.getElementById('files-count-badge');
        const clearFilesBtn = document.getElementById('clear-files-btn');
        const qualitySlider = document.getElementById('upload-quality') as HTMLInputElement | null;
        const qualityVal = document.getElementById('quality-val');
        const uploadForm = document.getElementById('upload-form');
        const progressBar = document.getElementById('upload-progress-bar');
        const progressFill = document.getElementById('upload-progress-fill');
        const progressPercent = document.getElementById('upload-percent-text');
        const progressStatus = document.getElementById('upload-status-text');
        const uploadSubmitBtn = document.getElementById('upload-submit-btn');

        let selectedFiles: File[] = [];

        if (qualitySlider && qualityVal) {
            qualitySlider.addEventListener('input', () => {
                qualityVal.textContent = `${qualitySlider.value}%`;
            });
        }

        function updateFilesDisplay() {
            if (!previewsContainer || !filesList || !filesCountBadge) return;
            if (selectedFiles.length === 0) {
                previewsContainer.classList.add('hidden');
                filesList.innerHTML = '';
                return;
            }

            previewsContainer.classList.remove('hidden');
            filesCountBadge.textContent = `${selectedFiles.length} photo(s) prête(s) au traitement`;
            filesList.innerHTML = '';

            selectedFiles.forEach((file, index) => {
                const item = document.createElement('div');
                item.className = 'relative group aspect-square rounded-xl overflow-hidden bg-dark border border-white/10';
                
                const img = document.createElement('img');
                img.className = 'w-full h-full object-cover';
                img.src = URL.createObjectURL(file);

                const removeBtn = document.createElement('button');
                removeBtn.type = 'button';
                removeBtn.className = 'absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-[10px] opacity-80 hover:opacity-100';
                removeBtn.innerHTML = '<i class="fa-solid fa-xmark"></i>';
                removeBtn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    selectedFiles.splice(index, 1);
                    updateFilesDisplay();
                });

                item.appendChild(img);
                item.appendChild(removeBtn);
                filesList.appendChild(item);
            });
        }

        if (dropZone && fileInput) {
            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('border-brand');
            });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-brand'));
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('border-brand');
                if (e.dataTransfer?.files) {
                    selectedFiles.push(...Array.from(e.dataTransfer.files));
                    updateFilesDisplay();
                }
            });

            fileInput.addEventListener('change', () => {
                if (fileInput.files) {
                    selectedFiles.push(...Array.from(fileInput.files));
                    updateFilesDisplay();
                }
            });
        }

        if (clearFilesBtn) {
            clearFilesBtn.addEventListener('click', () => {
                selectedFiles = [];
                updateFilesDisplay();
            });
        }

        if (uploadForm) {
            uploadForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                if (selectedFiles.length === 0) {
                    showToast('Veuillez sélectionner au moins une image.', 'info');
                    return;
                }

                const editionYear = (document.getElementById('upload-edition-year') as HTMLSelectElement).value;
                const photographerName = (document.getElementById('upload-photographer-name') as HTMLInputElement).value;
                const race = ((document.getElementById('upload-race') as HTMLInputElement)?.value || '').trim() || 'Toutes courses';
                const moment = ((document.getElementById('upload-moment') as HTMLInputElement)?.value || '').trim() || 'Moments forts';
                const maxWidth = (document.getElementById('upload-max-width') as HTMLSelectElement).value;
                const quality = (document.getElementById('upload-quality') as HTMLInputElement).value;
                const applyWatermark = (document.getElementById('upload-watermark') as HTMLInputElement).checked;

                const formData = new FormData();
                formData.append('type', 'gallery');
                formData.append('editionYear', editionYear);
                formData.append('photographerName', photographerName);
                formData.append('photographerSlug', photographerName.toLowerCase().replace(/[^a-z0-9-]/g, '-'));
                formData.append('race', race);
                formData.append('moment', moment);
                formData.append('maxWidth', maxWidth);
                formData.append('quality', quality);
                formData.append('applyWatermark', String(applyWatermark));

                selectedFiles.forEach(f => formData.append('photos', f));

                if (progressBar) progressBar.classList.remove('hidden');
                if (uploadSubmitBtn) uploadSubmitBtn.setAttribute('disabled', 'true');
                if (progressFill) progressFill.style.width = '45%';
                if (progressPercent) progressPercent.textContent = '45%';
                if (progressStatus) progressStatus.textContent = 'Conversion WebP, génération vignettes et filigrane...';

                try {
                    const res = await fetch('/api/upload', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        showToast(data.error || "Erreur lors de l'upload", 'error');
                    } else {
                        if (progressFill) progressFill.style.width = '100%';
                        if (progressPercent) progressPercent.textContent = '100%';
                        if (progressStatus) progressStatus.textContent = 'Traitement réussi !';
                        
                        showToast(`Succès ! ${data.count} image(s) traitée(s) et ajoutée(s) à la galerie.`, 'success');
                        selectedFiles = [];
                        updateFilesDisplay();
                        setTimeout(() => window.location.reload(), 800);
                    }
                } catch (err: any) {
                    showToast('Erreur réseau : ' + err.message, 'error');
                } finally {
                    if (uploadSubmitBtn) uploadSubmitBtn.removeAttribute('disabled');
                }
            });
        }

        // ==========================================
        // 8. Gestion des Administrateurs
        // ==========================================
        const createAdminForm = document.getElementById('create-admin-form');
        if (createAdminForm) {
            createAdminForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const username = (document.getElementById('new-admin-username') as HTMLInputElement).value;
                const password = (document.getElementById('new-admin-password') as HTMLInputElement).value;
                const role = (document.getElementById('new-admin-role') as HTMLSelectElement).value;

                const errBox = document.getElementById('create-admin-error');
                const succBox = document.getElementById('create-admin-success');
                if (errBox) errBox.classList.add('hidden');
                if (succBox) succBox.classList.add('hidden');

                try {
                    const res = await fetch('/api/admins', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username, password, role })
                    });
                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        if (errBox) {
                            errBox.textContent = data.error || 'Erreur création administrateur';
                            errBox.classList.remove('hidden');
                        }
                    } else {
                        showToast(`Compte "${data.admin.username}" créé avec succès !`, 'success');
                        if (succBox) {
                            succBox.textContent = `Compte "${data.admin.username}" créé avec succès !`;
                            succBox.classList.remove('hidden');
                        }
                        setTimeout(() => window.location.reload(), 800);
                    }
                } catch (err: any) {
                    if (errBox) {
                        errBox.textContent = err.message || 'Erreur réseau';
                        errBox.classList.remove('hidden');
                    }
                }
            });
        }

        // Suppression d'administrateur
        document.querySelectorAll('.delete-admin-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                if (!confirm('Êtes-vous sûr de vouloir supprimer cet administrateur ?')) return;

                try {
                    const res = await fetch(`/api/admins?id=${id}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (res.ok && data.success) {
                        showToast('Administrateur supprimé avec succès', 'success');
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        showToast(data.error || 'Impossible de supprimer', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                }
            });
        });

        // ==========================================
        // 9. Gestion du Règlement Officiel & Traitement PDF
        // ==========================================
        const uploadReglementForm = document.getElementById('upload-reglement-form') as HTMLFormElement | null;
        const reglementDropZone = document.getElementById('drop-zone-reglement');
        const reglementFileInput = document.getElementById('upload-reglement-file') as HTMLInputElement | null;
        const reglementSelectedFilename = document.getElementById('selected-reglement-filename');
        const reglementAutoParse = document.getElementById('reglement-auto-parse') as HTMLInputElement | null;
        const uploadReglementBtn = document.getElementById('upload-reglement-submit-btn') as HTMLButtonElement | null;

        let currentSelectedPdfFile: File | null = null;

        function setReglementFile(file: File | null) {
            currentSelectedPdfFile = file;
            if (reglementSelectedFilename) {
                if (file) {
                    const sizeKb = Math.round(file.size / 1024);
                    reglementSelectedFilename.innerHTML = `<span class="inline-flex items-center gap-1.5 text-brand font-semibold"><i class="fa-solid fa-circle-check"></i> ${file.name} (${sizeKb} Ko)</span>`;
                    reglementSelectedFilename.classList.remove('text-gray-400', 'bg-white/5');
                    reglementSelectedFilename.classList.add('text-brand', 'bg-brand/10', 'border', 'border-brand/30');
                } else {
                    reglementSelectedFilename.textContent = 'Format PDF uniquement (ex: reglement-2026.pdf)';
                    reglementSelectedFilename.classList.add('text-gray-400', 'bg-white/5');
                    reglementSelectedFilename.classList.remove('text-brand', 'bg-brand/10', 'border', 'border-brand/30');
                }
            }
        }

        if (reglementFileInput) {
            reglementFileInput.addEventListener('change', () => {
                if (reglementFileInput.files && reglementFileInput.files.length > 0) {
                    setReglementFile(reglementFileInput.files[0]);
                }
            });
        }

        if (reglementDropZone) {
            reglementDropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                reglementDropZone.classList.add('border-brand', 'bg-brand/5');
            });

            reglementDropZone.addEventListener('dragleave', () => {
                reglementDropZone.classList.remove('border-brand', 'bg-brand/5');
            });

            reglementDropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                reglementDropZone.classList.remove('border-brand', 'bg-brand/5');
                if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                    const file = e.dataTransfer.files[0];
                    if (file.type === 'application/pdf' || file.name.toLowerCase().endsWith('.pdf')) {
                        setReglementFile(file);
                    } else {
                        showToast('Veuillez déposer un fichier au format PDF', 'error');
                    }
                }
            });
        }

        if (uploadReglementForm) {
            uploadReglementForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const fileToUpload = currentSelectedPdfFile || (reglementFileInput?.files && reglementFileInput.files.length > 0 ? reglementFileInput.files[0] : null);

                if (!fileToUpload) {
                    showToast('Veuillez d\'abord sélectionner un fichier PDF', 'error');
                    return;
                }

                if (uploadReglementBtn) {
                    uploadReglementBtn.setAttribute('disabled', 'true');
                    uploadReglementBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Traitement du PDF en cours...';
                }

                try {
                    const formData = new FormData();
                    formData.append('file', fileToUpload);
                    formData.append('autoParse', reglementAutoParse ? String(reglementAutoParse.checked) : 'true');

                    const res = await fetch('/api/reglement', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await res.json();
                    if (!res.ok || !data.success) {
                        showToast(data.error || 'Erreur lors du traitement du règlement', 'error');
                    } else {
                        showToast(`Succès ! PDF mis en ligne et ${data.count || 0} article(s) découverts.`, 'success');
                        try {
                            localStorage.setItem('admin_active_tab', 'reglement');
                            window.location.hash = '#reglement';
                        } catch(e) {}
                        setTimeout(() => window.location.reload(), 800);
                    }
                } catch (err: any) {
                    showToast('Erreur réseau : ' + err.message, 'error');
                } finally {
                    if (uploadReglementBtn) {
                        uploadReglementBtn.removeAttribute('disabled');
                        uploadReglementBtn.innerHTML = '<i class="fa-solid fa-wand-magic-sparkles"></i> <span>Traiter & Mettre en Ligne</span>';
                    }
                }
            });
        }

        // Gestion de la modale des chapitres
        const openNewChapterBtn = document.getElementById('open-new-chapter-btn');
        const chapterModalForm = document.getElementById('chapter-modal-form') as HTMLFormElement | null;
        const chapterModalTitle = document.getElementById('chapter-modal-title');
        const modalChapterId = document.getElementById('modal-chapter-id') as HTMLInputElement | null;
        const modalChapterMode = document.getElementById('modal-chapter-mode') as HTMLInputElement | null;
        const modalChapterNumber = document.getElementById('modal-chapter-number') as HTMLInputElement | null;
        const modalChapterTitle = document.getElementById('modal-chapter-title') as HTMLInputElement | null;
        const modalChapterContent = document.getElementById('modal-chapter-content') as HTMLTextAreaElement | null;
        const modalChapterSubmitBtn = document.getElementById('modal-chapter-submit-btn');

        if (openNewChapterBtn) {
            openNewChapterBtn.addEventListener('click', () => {
                if (modalChapterId) modalChapterId.value = '';
                if (modalChapterMode) modalChapterMode.value = 'create';
                if (modalChapterNumber) modalChapterNumber.value = 'Article ' + (document.querySelectorAll('.edit-chapter-btn').length + 1);
                if (modalChapterTitle) modalChapterTitle.value = '';
                if (modalChapterContent) modalChapterContent.value = '';
                if (chapterModalTitle) chapterModalTitle.textContent = 'Ajouter un Article au Règlement';
                openModal('chapter-modal');
            });
        }

        // Clic sur bouton "Modifier" un chapitre
        document.querySelectorAll('.edit-chapter-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                const dataRaw = btn.getAttribute('data-chapter');
                if (!dataRaw) return;
                try {
                    const chapter = JSON.parse(dataRaw);
                    if (modalChapterId) modalChapterId.value = chapter.id;
                    if (modalChapterMode) modalChapterMode.value = 'edit';
                    if (modalChapterNumber) modalChapterNumber.value = chapter.number || '';
                    if (modalChapterTitle) modalChapterTitle.value = chapter.title || '';
                    if (modalChapterContent) modalChapterContent.value = chapter.content || '';
                    if (chapterModalTitle) chapterModalTitle.textContent = 'Modifier l\'Article';
                    openModal('chapter-modal');
                } catch (e) {
                    console.error('Erreur lecture données chapitre', e);
                }
            });
        });

        // Enregistrement d'un chapitre (création ou édition)
        if (chapterModalForm) {
            chapterModalForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const id = modalChapterId ? modalChapterId.value.trim() : '';
                const mode = modalChapterMode ? modalChapterMode.value : 'create';
                const number = modalChapterNumber ? modalChapterNumber.value.trim() : '';
                const title = modalChapterTitle ? modalChapterTitle.value.trim() : '';
                const content = modalChapterContent ? modalChapterContent.value.trim() : '';

                if (modalChapterSubmitBtn) modalChapterSubmitBtn.setAttribute('disabled', 'true');

                try {
                    // Récupérer la liste actuelle des chapitres
                    const getRes = await fetch('/api/reglement');
                    const getData = await getRes.json();
                    let chapters = (getData.reglement && getData.reglement.chapters) ? [...getData.reglement.chapters] : [];

                    if (mode === 'create') {
                        const newId = `article-${Date.now()}`;
                        chapters.push({ id: newId, number, title, content });
                    } else {
                        const idx = chapters.findIndex((c: any) => c.id === id);
                        if (idx !== -1) {
                            chapters[idx] = { ...chapters[idx], number, title, content };
                        } else {
                            chapters.push({ id, number, title, content });
                        }
                    }

                    const postRes = await fetch('/api/reglement', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chapters })
                    });

                    const postData = await postRes.json();
                    if (!postRes.ok || !postData.success) {
                        showToast(postData.error || 'Erreur lors de l\'enregistrement', 'error');
                    } else {
                        showToast('Article enregistré avec succès !', 'success');
                        closeModal('chapter-modal');
                        try {
                            localStorage.setItem('admin_active_tab', 'reglement');
                            window.location.hash = '#reglement';
                        } catch(e) {}
                        setTimeout(() => window.location.reload(), 600);
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                } finally {
                    if (modalChapterSubmitBtn) modalChapterSubmitBtn.removeAttribute('disabled');
                }
            });
        }

        // Suppression d'un chapitre
        document.querySelectorAll('.delete-chapter-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const id = btn.getAttribute('data-id');
                const title = btn.getAttribute('data-title') || 'cet article';
                if (!confirm(`Êtes-vous sûr de vouloir supprimer ${title} ?`)) return;

                try {
                    const getRes = await fetch('/api/reglement');
                    const getData = await getRes.json();
                    let chapters = (getData.reglement && getData.reglement.chapters) ? [...getData.reglement.chapters] : [];
                    const filtered = chapters.filter((c: any) => c.id !== id);

                    const postRes = await fetch('/api/reglement', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ chapters: filtered })
                    });

                    const postData = await postRes.json();
                    if (postRes.ok && postData.success) {
                        showToast('Article supprimé avec succès', 'success');
                        try {
                            localStorage.setItem('admin_active_tab', 'reglement');
                            window.location.hash = '#reglement';
                        } catch(e) {}
                        setTimeout(() => window.location.reload(), 600);
                    } else {
                        showToast(postData.error || 'Erreur lors de la suppression', 'error');
                    }
                } catch (err: any) {
                    showToast('Erreur : ' + err.message, 'error');
                }
            });
        });

    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAdmin);
    } else {
        initAdmin();
    }
</script>

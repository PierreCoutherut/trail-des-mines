                    <label class="block text-xs uppercase text-gray-400 font-display mb-1">Description éditoriale</label>
                    <textarea id="modal-ed-desc" rows="3" placeholder="Racontez les faits marquants de cette édition..." class="w-full bg-dark/80 border border-white/15 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-brand"></textarea>
                </div>

                <div>
                    <label class="block text-xs uppercase text-gray-400 font-display mb-1">Faits marquants (1 par ligne)</label>
                    <textarea id="modal-ed-highlights" rows="2" placeholder="Record scratch pulvérisé&#10;720 finishers à Champagney" class="w-full bg-dark/80 border border-white/15 rounded-xl p-3 text-sm text-white focus:outline-none focus:border-brand"></textarea>
                </div>

                <!-- Upload de l'Affiche -->
                <div class="bg-dark/60 p-4 rounded-xl border border-white/10">
                    <label class="block text-xs uppercase tracking-wider text-brand font-display font-bold mb-2">
                        <i class="fa-solid fa-image mr-1"></i> Affiche Officielle
                    </label>
                    <div class="flex items-center gap-4">
                        <div id="modal-ed-poster-preview-container" class="hidden">
                            <img id="modal-ed-poster-preview" src="" alt="Affiche actuelle" class="w-14 h-20 object-cover rounded-lg border border-white/20" />
                        </div>
                        <div class="flex-1">
                            <input type="file" id="modal-ed-poster-file" accept="image/*" class="text-xs text-gray-400 file:mr-3 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-brand file:text-dark hover:file:bg-white" />
                            <span class="text-[10px] text-gray-500 font-mono block mt-1">Laissez vide pour conserver l'affiche actuelle.</span>
                        </div>
                    </div>
                </div>

                <div class="pt-4 flex items-center justify-end gap-3">
                    <button type="button" class="modal-close-btn px-4 py-2.5 rounded-xl text-xs text-gray-400 hover:text-white transition" data-modal="edition-modal">Annuler</button>
                    <button type="submit" id="modal-ed-submit-btn" class="bg-brand text-dark font-display font-bold uppercase tracking-wider text-xs px-6 py-2.5 rounded-xl hover:bg-white transition shadow-md">Enregistrer</button>
                </div>
            </form>
        </div>
    </div>




                    <label class="block text-xs uppercase text-gray-400 font-display mb-1">Instagram (@compte ou URL)</label>
                    <input type="text" id="modal-photo-instagram" placeholder="@julien_trail_photo" class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand" />
                </div>


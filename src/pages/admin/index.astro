---
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate');

import Layout from '../../layouts/Layout.astro';
import { getAllEditionsSync } from '../../lib/db';
import { getAdmins, verifyToken } from '../../lib/auth';
import { getReglementSync } from '../../lib/reglement';

// Vérification de session côté serveur
const cookieHeader = Astro.request.headers.get('cookie') || '';
const tokenMatch = cookieHeader.match(/tdm_admin_token=([^;]+)/);
const token = tokenMatch ? tokenMatch[1] : null;

let currentUser: { username: string; role: string } | null = null;
if (token) {
  const check = verifyToken(token);
  if (check.valid && check.user) {
    currentUser = check.user;
  }
}

const editions = getAllEditionsSync();
const reglement = getReglementSync();
const totalPhotos = editions.reduce(
  (acc, e) => acc + e.galleries.reduce((gAcc, g) => gAcc + g.subGalleries.reduce((sAcc, s) => sAcc + s.photos.length, 0), 0),
  0
);
const allPhotographers = Array.from(new Set(editions.flatMap(e => e.galleries.map(g => g.photographerSlug))));
const adminsList = currentUser ? getAdmins().map(a => ({ id: a.id, username: a.username, role: a.role, createdAt: a.createdAt })) : [];
---

<Layout title="Administration - Trail des Mines" description="Espace d'administration des éditions, résultats et galeries photos" showCta={false} showSponsors={false}>

    <div class="min-h-screen pt-28 pb-20 px-4 max-w-7xl mx-auto">
        
        {/* =========================================================================
            SI NON CONNECTÉ : FORMULAIRE DE CONNEXION ÉLÉGANT
            ========================================================================= */}
        {!currentUser ? (
            <div class="max-w-md mx-auto my-12 bg-cardBg/90 backdrop-blur-xl p-8 rounded-3xl border border-white/10 shadow-2xl">
                <div class="text-center mb-8">
                    <img src="/medias/Logo.png" alt="Logo Trail des Mines" class="h-14 w-auto mx-auto mb-4 drop-shadow-lg" />
                    <h1 class="font-display text-3xl font-bold uppercase tracking-wider text-white">
                        Espace <span class="text-brand">Admin</span>
                    </h1>
                    <p class="text-gray-400 text-xs mt-1">Trail des Mines • Champagney</p>
                </div>

                <div class="bg-brand/10 border border-brand/20 p-3.5 rounded-2xl mb-6 text-xs text-brand flex items-center gap-3">
                    <i class="fa-solid fa-circle-info text-base shrink-0"></i>
                    <span>Accès sécurisé réservé aux organisateurs du Trail des Mines.</span>
                </div>

                <form id="login-form" class="space-y-4">
                    <div id="login-error" class="hidden p-3.5 bg-red-500/20 border border-red-500/40 rounded-xl text-xs text-red-300 font-semibold"></div>

                    <div>
                        <label for="login-username" class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Identifiant</label>
                        <div class="relative">
                            <i class="fa-solid fa-user absolute left-4 top-3.5 text-gray-500 text-sm"></i>
                            <input 
                              type="text" 
                              id="login-username" 
                              name="username" 
                              placeholder="ex: root" 
                              required 
                              class="w-full bg-dark/80 border border-white/15 rounded-xl pl-11 pr-4 py-3 text-sm text-white focus:outline-none focus:border-brand transition"
                            />
                        </div>
                    </div>

                    <div>
                        <label for="login-password" class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Mot de passe</label>
                        <div class="relative">
                            <i class="fa-solid fa-lock absolute left-4 top-3.5 text-gray-500 text-sm"></i>
                            <input 
                              type="password" 
                              id="login-password" 
                              name="password" 
                              placeholder="••••••••" 
                              required 
                              class="w-full bg-dark/80 border border-white/15 rounded-xl pl-11 pr-4 py-3 text-sm text-white focus:outline-none focus:border-brand transition"
                            />
                        </div>
                    </div>

                    <button 
                      type="submit" 
                      id="login-submit-btn"
                      class="w-full bg-brand text-dark font-display font-bold uppercase tracking-wider text-xs py-3.5 rounded-xl hover:bg-white transition-all shadow-lg shadow-brand/20 mt-2 flex items-center justify-center gap-2"
                    >
                        <span>Se Connecter</span>
                        <i class="fa-solid fa-arrow-right text-xs"></i>
                    </button>
                </form>
            </div>
        ) : (
            /* =========================================================================
               SI CONNECTÉ : TABLEAU DE BORD D'ADMINISTRATION
               ========================================================================= */
            <div>
                <!-- En-tête de la console d'administration -->
                <header class="bg-cardBg/90 backdrop-blur-xl rounded-3xl p-6 md:p-8 border border-white/10 shadow-2xl mb-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <img src="/medias/Logo.png" alt="Logo" class="h-12 w-auto object-contain hidden sm:block" />
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-display uppercase tracking-widest text-brand font-bold">
                                    Console d'Administration
                                </span>
                                <span class="text-[9px] font-mono px-2 py-0.5 rounded-full bg-brand/20 text-brand border border-brand/30">
                                    En direct
                                </span>
                            </div>
                            <h1 class="font-display text-2xl sm:text-3xl font-bold uppercase text-white mt-0.5">
                                Gestion Trail des Mines
                            </h1>
                            <span class="text-xs text-gray-400 font-mono">
                                Connecté en tant que <strong class="text-brand">{currentUser.username}</strong> ({currentUser.role})
                            </span>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-3">
                        <a 
                          href="/editions-precedentes" 
                          target="_blank" 
                          class="bg-white/10 hover:bg-white/20 text-white px-4 py-2.5 rounded-xl text-xs font-display uppercase tracking-wider transition border border-white/10 inline-flex items-center gap-2"
                        >
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                            <span>Voir le site</span>
                        </a>
                        <button 
                          id="logout-btn" 
                          class="bg-red-500/20 hover:bg-red-500/30 text-red-300 border border-red-500/40 px-4 py-2.5 rounded-xl text-xs font-display uppercase tracking-wider transition inline-flex items-center gap-2"
                        >
                            <i class="fa-solid fa-power-off text-xs"></i>
                            <span>Déconnexion</span>
                        </button>
                    </div>
                </header>

                <!-- Statistiques Globales -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="bg-cardBg/70 rounded-2xl p-4 border border-white/5 text-center">
                        <span class="text-[10px] uppercase text-gray-400 font-mono block mb-1">Éditions Référencées</span>
                        <span class="font-display text-3xl font-bold text-brand">{editions.length}</span>
                    </div>
                    <div class="bg-cardBg/70 rounded-2xl p-4 border border-white/5 text-center">
                        <span class="text-[10px] uppercase text-gray-400 font-mono block mb-1">Total Photos HD</span>
                        <span class="font-display text-3xl font-bold text-white">{totalPhotos}</span>
                    </div>
                    <div class="bg-cardBg/70 rounded-2xl p-4 border border-white/5 text-center">
                        <span class="text-[10px] uppercase text-gray-400 font-mono block mb-1">Photographes</span>
                        <span class="font-display text-3xl font-bold text-cyan-400">{allPhotographers.length}</span>
                    </div>
                    <div class="bg-cardBg/70 rounded-2xl p-4 border border-white/5 text-center">
                        <span class="text-[10px] uppercase text-gray-400 font-mono block mb-1">Administrateurs</span>
                        <span class="font-display text-3xl font-bold text-brand">{adminsList.length}</span>
                    </div>
                </div>

                <!-- Onglets Principaux du Back-Office -->
                <div class="flex flex-wrap gap-2 mb-8 bg-cardBg/60 p-1.5 rounded-2xl border border-white/10" id="admin-tabs">
                    <button data-tab="editions" class="admin-tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center justify-center gap-2 bg-brand text-dark shadow">
                        <i class="fa-solid fa-flag"></i> Éditions & Affiches
                    </button>
                    <button data-tab="resultats" class="admin-tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center justify-center gap-2 bg-transparent text-gray-300 hover:text-white hover:bg-white/5">
                        <i class="fa-solid fa-square-poll-vertical text-brand"></i> Liens Résultats
                    </button>
                    <button data-tab="upload" class="admin-tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center justify-center gap-2 bg-transparent text-gray-300 hover:text-white hover:bg-white/5">
                        <i class="fa-solid fa-wand-magic-sparkles"></i> Upload Photos
                    </button>
                    <button data-tab="galleries" class="admin-tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center justify-center gap-2 bg-transparent text-gray-300 hover:text-white hover:bg-white/5">
                        <i class="fa-solid fa-camera"></i> Galeries & Photos
                    </button>
                    <button data-tab="admins" class="admin-tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center justify-center gap-2 bg-transparent text-gray-300 hover:text-white hover:bg-white/5">
                        <i class="fa-solid fa-users-gear"></i> Administrateurs
                    </button>
                    <button data-tab="reglement" class="admin-tab-btn flex-1 min-w-[140px] py-3 px-4 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center justify-center gap-2 bg-transparent text-gray-300 hover:text-white hover:bg-white/5">
                        <i class="fa-solid fa-file-contract text-brand"></i> Règlement PDF
                    </button>
                </div>

                {/* =========================================================================
                    ONGLET 1 : GESTION DES ÉDITIONS & AFFICHES
                    ========================================================================= */}
                <div id="tab-panel-editions" class="tab-panel space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="font-display text-2xl font-bold uppercase text-white">Éditions du Trail des Mines</h2>
                            <p class="text-xs text-gray-400">Modifiez les textes, dates, affiches officielles et faits marquants de chaque année</p>
                        </div>
                        <button id="open-new-edition-btn" class="bg-brand text-dark px-5 py-2.5 rounded-xl font-display uppercase tracking-wider text-xs font-bold hover:bg-white transition flex items-center gap-2 shadow-lg shadow-brand/20 self-start sm:self-auto">
                            <i class="fa-solid fa-plus"></i>
                            <span>Créer une Édition</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {editions.map(ed => (
                            <div class="bg-cardBg rounded-3xl p-6 border border-white/10 shadow-xl flex flex-col justify-between hover:border-brand/30 transition">
                                <div>
                                    <div class="flex gap-4 mb-4">
                                        <div class="w-24 h-32 rounded-xl overflow-hidden bg-dark shrink-0 border border-white/10 relative group">
                                            <img src={ed.posterUrl} alt={`Affiche ${ed.year}`} class="w-full h-full object-cover" />
                                        </div>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between">
                                                <span class="text-xs font-display text-brand font-bold uppercase">{ed.subtitle}</span>
                                                <span class="text-xs font-mono bg-white/10 text-white px-2 py-0.5 rounded font-bold">{ed.year}</span>
                                            </div>
                                            <h3 class="font-display text-xl font-bold uppercase text-white mt-1">{ed.title}</h3>
                                            <span class="text-xs text-gray-400 font-mono block mt-0.5">
                                                <i class="fa-regular fa-calendar mr-1"></i>{ed.date}
                                            </span>
                                            <div class="flex flex-wrap gap-2 text-xs text-gray-300 mt-2 font-mono">
                                                <span class="bg-dark/80 px-2 py-0.5 rounded border border-white/5">
                                                    <strong class="text-brand">{ed.races?.length || 0}</strong> course(s)
                                                </span>
                                                <span class="bg-dark/80 px-2 py-0.5 rounded border border-white/5">
                                                    <strong class="text-brand">{ed.galleries?.length || 0}</strong> galerie(s)
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <p class="text-gray-300 text-xs leading-relaxed line-clamp-3 mb-4">{ed.description}</p>

                                    {ed.highlights && ed.highlights.length > 0 && (
                                        <div class="bg-dark/50 p-3 rounded-xl border border-white/5 mb-4 text-[11px] text-gray-300 space-y-1">
                                            <span class="font-display uppercase text-brand text-[10px] font-bold block">Moments clés :</span>
                                            {ed.highlights.slice(0, 2).map(h => (
                                                <div class="flex items-start gap-1.5">
                                                    <i class="fa-solid fa-check text-brand text-[10px] mt-1 shrink-0"></i>
                                                    <span class="line-clamp-1">{h}</span>
                                                </div>
                                            ))}
                                        </div>
                                    )}
                                </div>

                                <div class="flex items-center justify-between pt-4 border-t border-white/10">
                                    <a href={`/editions-precedentes/${ed.year}`} target="_blank" class="text-xs text-brand hover:underline inline-flex items-center gap-1.5 font-mono">
                                        <span>Consulter la page</span>
                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                    </a>
                                    <div class="flex items-center gap-2">
                                        <button 
                                          type="button"
                                          class="jump-to-results-btn bg-white/5 hover:bg-brand/20 text-gray-300 hover:text-brand text-xs px-3 py-2 rounded-xl transition font-semibold flex items-center gap-1.5 border border-white/10"
                                          data-year={ed.year}
                                          title="Gérer les liens de résultats"
                                        >
                                            <i class="fa-solid fa-square-poll-vertical text-brand"></i>
                                            <span>Résultats ({ed.resultLinks?.length || 0})</span>
                                        </button>
                                        <button 
                                          class="edit-edition-btn bg-brand/20 hover:bg-brand text-brand hover:text-dark text-xs px-3 py-2 rounded-xl transition font-semibold flex items-center gap-1.5"
                                          data-edition={JSON.stringify(ed)}
                                        >
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            <span>Modifier</span>
                                        </button>
                                        <button 
                                          class="delete-edition-btn text-red-400 hover:text-red-300 bg-red-500/10 hover:bg-red-500/20 text-xs px-3 py-2 rounded-xl transition flex items-center gap-1"
                                          data-year={ed.year}
                                          title="Supprimer cette édition"
                                        >
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                {/* =========================================================================
                    ONGLET 2 : GESTIONNAIRE DE LIENS DE RÉSULTATS EXTERNES
                    ========================================================================= */}
                <div id="tab-panel-resultats" class="tab-panel hidden space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="font-display text-2xl font-bold uppercase text-white">Liens des Résultats</h2>
                            <p class="text-xs text-gray-400">Gérez les liens externes vers les plateformes de chronométrage (ChronoStart, PDF, etc.) pour chaque édition</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-brand font-mono bg-brand/10 border border-brand/20 px-3.5 py-1.5 rounded-xl">
                                <i class="fa-solid fa-link mr-1.5"></i> Liens externes illimités
                            </span>
                        </div>
                    </div>

                    <!-- Sélecteur d'année pour les résultats -->
                    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-white/10" id="results-year-tabs">
                        {editions.map((ed, idx) => (
                            <button 
                              class={`results-year-btn px-4 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition flex items-center gap-2 shrink-0 ${idx === 0 ? 'bg-brand text-dark shadow' : 'bg-cardBg text-gray-300 hover:text-white'}`}
                              data-year={ed.year}
                            >
                                <i class="fa-solid fa-calendar-day"></i>
                                <span>{ed.year} • {ed.title}</span>
                                <span class="text-[10px] px-2 py-0.5 rounded-full bg-dark/30 font-mono font-normal">
                                    {(ed.resultLinks || []).length}
                                </span>
                            </button>
                        ))}
                    </div>

                    <!-- Conteneurs de liens de résultats par année -->
                    {editions.map((ed, idx) => (
                        <div class={`results-year-container space-y-6 ${idx === 0 ? '' : 'hidden'}`} id={`results-year-${ed.year}`} data-year={ed.year}>
                            <div class="bg-cardBg rounded-3xl p-6 sm:p-8 border border-white/10 shadow-xl space-y-6">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
                                    <div>
                                        <h3 class="font-display text-xl font-bold uppercase text-white flex items-center gap-2">
                                            <span>Résultats de l'Édition {ed.year}</span>
                                            <span class="text-xs font-mono font-normal text-brand">({ed.title})</span>
                                        </h3>
                                        <p class="text-xs text-gray-400 mt-1">
                                            Ajoutez les intitulés et les adresses web complètes. Ils s'afficheront sous forme de boutons cliquables sur la page publique.
                                        </p>
                                    </div>
                                    <div class="flex items-center gap-2 self-start sm:self-auto">
                                        <button 
                                          type="button" 
                                          class="add-result-link-row-btn bg-white/10 hover:bg-white/20 text-white text-xs px-4 py-2 rounded-xl transition font-display uppercase tracking-wider font-bold flex items-center gap-2 border border-white/10"
                                          data-year={ed.year}
                                        >
                                            <i class="fa-solid fa-plus text-brand"></i>
                                            <span>Ajouter un lien</span>
                                        </button>
                                        <button 
                                          type="button" 
                                          class="save-year-results-btn bg-brand text-dark hover:bg-white text-xs px-5 py-2 rounded-xl transition font-display uppercase tracking-wider font-bold shadow-lg shadow-brand/20 flex items-center gap-2"
                                          data-year={ed.year}
                                        >
                                            <i class="fa-solid fa-floppy-disk"></i>
                                            <span>Enregistrer ({ed.year})</span>
                                        </button>
                                    </div>
                                </div>

                                <!-- Liste répétable des liens -->
                                <div class="result-links-list space-y-3" id={`result-links-list-${ed.year}`}>
                                    {(!ed.resultLinks || ed.resultLinks.length === 0) ? (
                                        <div class="empty-links-notice bg-dark/40 rounded-2xl p-8 text-center border border-dashed border-white/15">
                                            <i class="fa-solid fa-trophy text-3xl text-gray-500 mb-3 block"></i>
                                            <p class="text-gray-400 text-sm mb-4">Aucun lien de résultat configuré pour l'édition {ed.year}.</p>
                                            <button 
                                              type="button" 
                                              class="add-result-link-row-btn bg-brand text-dark text-xs px-4 py-2 rounded-xl font-bold uppercase font-display tracking-wider"
                                              data-year={ed.year}
                                            >
                                                <i class="fa-solid fa-plus mr-1"></i> Ajouter un premier lien
                                            </button>
                                        </div>
                                    ) : (
                                        ed.resultLinks.map((link, lIdx) => (
                                            <div class="result-link-row bg-dark/60 rounded-2xl p-4 border border-white/10 hover:border-brand/40 transition flex flex-col md:flex-row items-stretch md:items-center gap-3">
                                                <div class="link-row-index w-8 h-8 rounded-xl bg-brand/10 text-brand flex items-center justify-center font-mono font-bold text-xs shrink-0 self-start md:self-auto">
                                                    #{lIdx + 1}
                                                </div>
                                                <div class="flex-1">
                                                    <label class="block text-[10px] uppercase text-gray-400 font-display mb-1">Intitulé du résultat *</label>
                                                    <input 
                                                      type="text" 
                                                      class="link-label-input w-full bg-dark/90 border border-white/15 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-brand" 
                                                      value={link.label} 
                                                      placeholder="ex: Classement 52 km - ChronoStart" 
                                                      required 
                                                    />
                                                </div>
                                                <div class="flex-[1.5]">
                                                    <label class="block text-[10px] uppercase text-gray-400 font-display mb-1">Lien externe (URL complète) *</label>
                                                    <input 
                                                      type="url" 
                                                      class="link-url-input w-full bg-dark/90 border border-white/15 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none focus:border-brand font-mono text-xs" 
                                                      value={link.url} 
                                                      placeholder="https://www.chrono-start.com/..." 
                                                      required 
                                                    />
                                                </div>
                                                <div class="flex items-center gap-2 pt-2 md:pt-4 self-end md:self-auto shrink-0">
                                                    <a 
                                                      href={link.url} 
                                                      target="_blank" 
                                                      rel="noopener noreferrer" 
                                                      class="test-link-btn px-3 py-2 bg-white/5 hover:bg-brand/20 text-gray-300 hover:text-brand rounded-xl border border-white/10 text-xs font-medium transition inline-flex items-center gap-1.5"
                                                      title="Tester le lien"
                                                    >
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                                        <span class="hidden sm:inline">Tester</span>
                                                    </a>
                                                    <button 
                                                      type="button" 
                                                      class="delete-link-row-btn px-3 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl text-xs font-medium transition inline-flex items-center gap-1.5"
                                                      title="Supprimer cette ligne"
                                                    >
                                                        <i class="fa-solid fa-trash text-[11px]"></i>
                                                        <span class="hidden sm:inline">Supprimer</span>
                                                    </button>
                                                </div>
                                            </div>
                                        ))
                                    )}
                                </div>

                                <!-- Bas de panneau avec boutons d'ajout et d'enregistrement -->
                                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-white/10">
                                    <button 
                                      type="button" 
                                      class="add-result-link-row-btn bg-white/5 hover:bg-white/10 text-brand text-xs px-4 py-2.5 rounded-xl transition font-display uppercase tracking-wider font-bold flex items-center gap-2 border border-brand/20 hover:border-brand/50 w-full sm:w-auto justify-center"
                                      data-year={ed.year}
                                    >
                                        <i class="fa-solid fa-plus"></i>
                                        <span>Ajouter un autre lien</span>
                                    </button>

                                    <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                                        <a 
                                          href={`/editions-precedentes/${ed.year}#resultats`} 
                                          target="_blank" 
                                          class="text-xs text-gray-400 hover:text-white font-mono flex items-center gap-1.5"
                                        >
                                            <span>Voir le rendu public</span>
                                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                        </a>
                                        <button 
                                          type="button" 
                                          class="save-year-results-btn bg-brand text-dark hover:bg-white text-xs px-6 py-2.5 rounded-xl transition font-display uppercase tracking-wider font-bold shadow-lg shadow-brand/20 flex items-center gap-2 w-full sm:w-auto justify-center"
                                          data-year={ed.year}
                                        >
                                            <i class="fa-solid fa-floppy-disk"></i>
                                            <span>Enregistrer les liens</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* =========================================================================
                    ONGLET 3 : STUDIO D'UPLOAD & TRAITEMENT D'IMAGES
                    ========================================================================= */}
                <div id="tab-panel-upload" class="tab-panel hidden space-y-6">
                    <div class="bg-cardBg/90 backdrop-blur-md rounded-3xl p-6 sm:p-10 border border-white/10 shadow-2xl">
                        <div class="max-w-3xl mb-8">
                            <span class="text-xs font-display uppercase tracking-widest text-brand font-bold block mb-1">
                                Studio de Traitement & Compression
                            </span>
                            <h2 class="font-display text-3xl font-bold uppercase text-white mb-2">
                                Upload & Traitement Automatique d'Images
                            </h2>
                            <p class="text-gray-300 text-xs sm:text-sm leading-relaxed">
                                Déposez vos photos brutes (JPG, PNG). Le serveur les convertit automatiquement au format ultra-rapide <strong>WebP</strong>, génère les versions HD et vignettes légères, applique si souhaité le <strong>filigrane officiel</strong>, et les classe immédiatement dans la sous-galerie ciblée.
                            </p>
                        </div>

                        <form id="upload-form" class="space-y-6">
                            
                            <!-- Ligne 1 : Édition & Photographe -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Édition Cible</label>
                                    <select id="upload-edition-year" name="editionYear" class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand">
                                        {editions.map(e => (
                                            <option value={e.year}>{e.year} - {e.title}</option>
                                        ))}
                                    </select>
                                </div>

                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Photographe</label>
                                    <input 
                                      type="text" 
                                      id="upload-photographer-name" 
                                      name="photographerName" 
                                      placeholder="ex: Pierre Coutherut" 
                                      value="Pierre Coutherut"
                                      required
                                      class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand"
                                    />
                                </div>
                            </div>

                            <!-- Ligne 2 : Course & Moment (Sous-galerie) -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                                <div>
                                    <div class="flex items-center justify-between mb-1.5">
                                        <label class="block text-xs uppercase tracking-wider text-gray-400 font-display">Course Associée</label>
                                        <span class="text-[10px] font-mono text-gray-500 bg-white/5 px-2 py-0.5 rounded">Facultatif</span>
                                    </div>
                                    <input 
                                      type="text" 
                                      id="upload-race" 
                                      name="race" 
                                      placeholder="ex: Les Gueules Noires (52km)" 
                                      class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand"
                                    />
                                </div>

                                <div>
                                    <div class="flex items-center justify-between mb-1.5">
                                        <label class="block text-xs uppercase tracking-wider text-gray-400 font-display">Moment / Lieu Clé</label>
                                        <span class="text-[10px] font-mono text-gray-500 bg-white/5 px-2 py-0.5 rounded">Facultatif</span>
                                    </div>
                                    <input 
                                      type="text" 
                                      id="upload-moment" 
                                      name="moment" 
                                      placeholder="ex: Sommet Planche des Belles Filles" 
                                      class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-3 text-sm text-white focus:outline-none focus:border-brand"
                                    />
                                </div>
                            </div>

                            <!-- Options de Traitement d'Images -->
                            <div class="bg-dark/60 p-5 rounded-2xl border border-white/10 space-y-4">
                                <span class="text-xs uppercase tracking-wider text-brand font-display font-bold block">
                                    <i class="fa-solid fa-sliders mr-1.5"></i> Options de traitement Sharp
                                </span>

                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
                                    <div>
                                        <label class="block text-gray-400 mb-1 font-mono">Largeur Max HD</label>
                                        <select id="upload-max-width" name="maxWidth" class="w-full bg-cardBg border border-white/10 rounded-lg p-2 text-white">
                                            <option value="1920" selected>1920 px (Full HD Optimisé)</option>
                                            <option value="2560">2560 px (2K Haute Définition)</option>
                                            <option value="1440">1440 px (Format Éco Web)</option>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="block text-gray-400 mb-1 font-mono">Qualité WebP : <span id="quality-val" class="text-brand font-bold">85%</span></label>
                                        <input type="range" id="upload-quality" name="quality" min="60" max="95" value="85" class="w-full accent-brand" />
                                    </div>

                                    <div class="flex items-center gap-3 pt-4 sm:pt-0">
                                        <input type="checkbox" id="upload-watermark" name="applyWatermark" checked class="w-4 h-4 accent-brand rounded" />
                                        <label for="upload-watermark" class="text-white cursor-pointer select-none">
                                            Appliquer le filigrane <strong class="text-brand">Trail des Mines</strong>
                                        </label>
                                    </div>
                                </div>
                            </div>

                            <!-- Zone Drag & Drop -->
                            <div>
                                <label class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Sélection des photos</label>
                                <div id="drop-zone" class="border-2 border-dashed border-white/20 hover:border-brand/60 rounded-3xl p-8 sm:p-12 text-center bg-dark/40 cursor-pointer transition-colors duration-300">
                                    <i class="fa-solid fa-cloud-arrow-up text-4xl sm:text-5xl text-gray-400 mb-3 block"></i>
                                    <p class="text-sm sm:text-base font-semibold text-white mb-1">
                                        Glissez-déposez vos photos ici, ou <span class="text-brand underline">cliquez pour parcourir</span>
                                    </p>
                                    <p class="text-xs text-gray-500 font-mono">JPG, JPEG, PNG, WEBP acceptés • Plusieurs fichiers autorisés</p>
                                    <input type="file" id="upload-files" multiple accept="image/*" class="hidden" />
                                </div>
                            </div>

                            <!-- Liste des fichiers en attente -->
                            <div id="file-previews" class="hidden space-y-3">
                                <div class="flex items-center justify-between text-xs font-mono text-gray-400 pb-2 border-b border-white/10">
                                    <span id="files-count-badge">0 fichier(s) sélectionné(s)</span>
                                    <button type="button" id="clear-files-btn" class="text-red-400 hover:underline">Effacer la sélection</button>
                                </div>
                                <div id="files-list" class="grid grid-cols-2 sm:grid-cols-4 md:grid-cols-6 gap-3"></div>
                            </div>

                            <!-- Bouton de Soumission & Progression -->
                            <div class="pt-4">
                                <div id="upload-progress-bar" class="hidden mb-4">
                                    <div class="flex justify-between text-xs font-mono text-gray-300 mb-1">
                                        <span id="upload-status-text">Traitement et conversion en cours...</span>
                                        <span id="upload-percent-text" class="text-brand font-bold">0%</span>
                                    </div>
                                    <div class="w-full bg-dark rounded-full h-2.5 overflow-hidden border border-white/10">
                                        <div id="upload-progress-fill" class="bg-brand h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                                    </div>
                                </div>

                                <button 
                                  type="submit" 
                                  id="upload-submit-btn" 
                                  class="w-full bg-brand text-dark font-display font-bold uppercase tracking-wider text-sm py-4 rounded-xl hover:bg-white hover:scale-[1.01] transition-all shadow-xl shadow-brand/20 flex items-center justify-center gap-2"
                                >
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    <span>Lancer le Traitement & l'Upload</span>
                                </button>
                            </div>

                        </form>
                    </div>
                </div>

                {/* =========================================================================
                    ONGLET 4 : GALERIES & PHOTOS (GESTION COMPLÈTE & SUPPRESSION)
                    ========================================================================= */}
                <div id="tab-panel-galleries" class="tab-panel hidden space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="font-display text-2xl font-bold uppercase text-white">Galeries par Photographe</h2>
                            <p class="text-xs text-gray-400">Gérez les profils, les sous-galeries et supprimez individuellement des clichés</p>
                        </div>
                        <button id="open-new-photographer-btn" class="bg-brand text-dark px-5 py-2.5 rounded-xl font-display uppercase tracking-wider text-xs font-bold hover:bg-white transition flex items-center gap-2 shadow-lg shadow-brand/20 self-start sm:self-auto">
                            <i class="fa-solid fa-user-plus"></i>
                            <span>Nouveau Photographe</span>
                        </button>
                    </div>

                    <!-- Sélecteur d'année pour les galeries -->
                    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-white/10" id="galleries-year-tabs">
                        {editions.map((ed, idx) => (
                            <button 
                              class={`galleries-year-btn px-4 py-2 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition ${idx === 0 ? 'bg-brand text-dark shadow' : 'bg-cardBg text-gray-300 hover:text-white'}`}
                              data-year={ed.year}
                            >
                                {ed.year} ({ed.galleries?.length || 0} photographes)
                            </button>
                        ))}
                    </div>

                    {editions.map((ed, idx) => (
                        <div class={`galleries-year-container space-y-6 ${idx === 0 ? '' : 'hidden'}`} id={`galleries-year-${ed.year}`}>
                            {(!ed.galleries || ed.galleries.length === 0) ? (
                                <div class="bg-cardBg/60 rounded-2xl p-8 text-center border border-white/5">
                                    <p class="text-gray-400 text-sm">Aucune galerie créée pour cette édition.</p>
                                </div>
                            ) : (
                                <div class="grid grid-cols-1 gap-6">
                                    {ed.galleries.map(g => (
                                        <div class="bg-cardBg rounded-3xl p-6 border border-white/10 shadow-xl space-y-6">
                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-white/10">
                                                <div class="flex items-center gap-4">
                                                    <div class="w-12 h-12 rounded-full bg-brand/20 border border-brand/40 overflow-hidden flex items-center justify-center shrink-0">
                                                        {g.avatarUrl ? <img src={g.avatarUrl} alt="" class="w-full h-full object-cover" /> : <i class="fa-solid fa-camera text-brand text-lg"></i>}
                                                    </div>
                                                    <div>
                                                        <strong class="text-white text-lg block font-display uppercase">{g.photographerName}</strong>
                                                        <span class="text-xs text-gray-400 font-mono">
                                                            {g.instagramUrl ? `IG: ${g.instagramUrl}` : 'Photographe officiel'} • {g.subGalleries?.reduce((acc, s) => acc + s.photos.length, 0) || 0} photos au total
                                                        </span>
                                                        {g.bio && <p class="text-xs text-gray-300 mt-1 max-w-xl">{g.bio}</p>}
                                                    </div>
                                                </div>

                                                <div class="flex items-center gap-2">
                                                    <a 
                                                      href={`/editions-precedentes/${ed.year}/galerie/${g.photographerSlug}`} 
                                                      target="_blank"
                                                      class="text-xs text-brand hover:underline font-mono px-3 py-1.5 bg-white/5 rounded-lg inline-flex items-center gap-1"
                                                    >
                                                        <span>Voir l'album</span>
                                                        <i class="fa-solid fa-arrow-up-right-from-square text-[9px]"></i>
                                                    </a>
                                                    <button 
                                                      class="edit-photographer-btn text-xs px-3 py-1.5 bg-brand/20 hover:bg-brand text-brand hover:text-dark rounded-lg transition font-semibold"
                                                      data-photographer={JSON.stringify(g)}
                                                      data-year={ed.year}
                                                    >
                                                        <i class="fa-solid fa-pen mr-1"></i> Modifier
                                                    </button>
                                                    <button 
                                                      class="delete-photographer-btn text-xs px-3 py-1.5 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition"
                                                      data-slug={g.photographerSlug}
                                                      data-name={g.photographerName}
                                                      data-year={ed.year}
                                                      title="Supprimer ce photographe et ses photos"
                                                    >
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>

                                            <!-- Sous-galeries -->
                                            <div class="space-y-4">
                                                <span class="text-xs font-display uppercase tracking-wider text-gray-400 font-bold block">
                                                    Sous-galeries & Clichés ({g.subGalleries?.length || 0}) :
                                                </span>
                                                <div class="grid grid-cols-1 gap-4">
                                                    {g.subGalleries?.map(sub => (
                                                        <div class="bg-dark/70 p-4 rounded-2xl border border-white/5 space-y-3">
                                                            <div class="flex items-center justify-between">
                                                                <div>
                                                                    <span class="text-white font-bold text-sm block">{sub.name}</span>
                                                                    <span class="text-xs text-gray-400 font-mono">{sub.race} • {sub.moment}</span>
                                                                </div>
                                                                <div class="flex items-center gap-3">
                                                                    <span class="text-brand font-mono font-bold text-xs bg-brand/10 px-2.5 py-1 rounded-lg">
                                                                        {sub.photos.length} photo(s)
                                                                    </span>
                                                                    <button 
                                                                      class="toggle-photos-btn text-xs bg-white/10 hover:bg-white/20 text-white px-3 py-1 rounded-lg transition"
                                                                      data-target={`sub-photos-${sub.id}`}
                                                                    >
                                                                        <span>Gérer les photos</span>
                                                                        <i class="fa-solid fa-chevron-down text-[10px] ml-1"></i>
                                                                    </button>
                                                                </div>
                                                            </div>

                                                            <!-- Grille de photos (rétractable) -->
                                                            <div id={`sub-photos-${sub.id}`} class="hidden pt-3 border-t border-white/5">
                                                                {sub.photos.length === 0 ? (
                                                                    <p class="text-xs text-gray-500 font-mono">Aucune photo dans cette sous-galerie.</p>
                                                                ) : (
                                                                    <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 lg:grid-cols-8 gap-2.5">
                                                                        {sub.photos.map(p => (
                                                                            <div class="relative group aspect-square rounded-xl overflow-hidden bg-dark border border-white/10" id={`photo-card-${p.id}`}>
                                                                                <img src={p.urlThumb} alt="" class="w-full h-full object-cover group-hover:scale-105 transition" loading="lazy" />
                                                                                <button 
                                                                                  class="delete-single-photo-btn absolute top-1 right-1 bg-red-600 hover:bg-red-700 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition shadow-lg"
                                                                                  data-year={ed.year}
                                                                                  data-slug={g.photographerSlug}
                                                                                  data-photo-id={p.id}
                                                                                  title="Supprimer cette photo"
                                                                                >
                                                                                    <i class="fa-solid fa-trash text-[10px]"></i>
                                                                                </button>
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                {/* =========================================================================
                    ONGLET 5 : GESTION DES ADMINISTRATEURS
                    ========================================================================= */}
                <div id="tab-panel-admins" class="tab-panel hidden space-y-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <h2 class="font-display text-2xl font-bold uppercase text-white">Comptes Administrateurs</h2>
                            <p class="text-xs text-gray-400">Créez et gérez les accès d'administration du Trail des Mines</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
                        <!-- Formulaire Création Administrateur -->
                        <div class="lg:col-span-5 bg-cardBg rounded-3xl p-6 sm:p-8 border border-white/10 shadow-xl">
                            <h3 class="font-display text-xl font-bold uppercase text-white mb-4 flex items-center gap-2">
                                <i class="fa-solid fa-user-plus text-brand text-sm"></i>
                                <span>Ajouter un Administrateur</span>
                            </h3>

                            <form id="create-admin-form" class="space-y-4">
                                <div id="create-admin-error" class="hidden p-3 bg-red-500/20 border border-red-500/40 rounded-xl text-xs text-red-300 font-semibold"></div>
                                <div id="create-admin-success" class="hidden p-3 bg-green-500/20 border border-green-500/40 rounded-xl text-xs text-green-300 font-semibold"></div>

                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Identifiant</label>
                                    <input 
                                      type="text" 
                                      id="new-admin-username" 
                                      placeholder="ex: pierre, julien" 
                                      required 
                                      class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand"
                                    />
                                </div>

                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Mot de passe</label>
                                    <input 
                                      type="password" 
                                      id="new-admin-password" 
                                      placeholder="••••••••" 
                                      required 
                                      class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand"
                                    />
                                </div>

                                <div>
                                    <label class="block text-xs uppercase tracking-wider text-gray-400 font-display mb-1.5">Rôle</label>
                                    <select id="new-admin-role" class="w-full bg-dark/80 border border-white/15 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-brand">
                                        <option value="admin">Administrateur (Gestion éditions & photos)</option>
                                        <option value="superadmin">Super-administrateur (Accès total)</option>
                                    </select>
                                </div>

                                <button 
                                  type="submit" 
                                  class="w-full bg-brand text-dark font-display font-bold uppercase tracking-wider text-xs py-3 rounded-xl hover:bg-white transition shadow-md mt-2 flex items-center justify-center gap-2"
                                >
                                    <i class="fa-solid fa-check"></i>
                                    <span>Créer ce compte</span>
                                </button>
                            </form>
                        </div>

                        <!-- Liste des Administrateurs -->
                        <div class="lg:col-span-7 bg-cardBg rounded-3xl p-6 sm:p-8 border border-white/10 shadow-xl">
                            <h3 class="font-display text-xl font-bold uppercase text-white mb-4">
                                Administrateurs Actifs ({adminsList.length})
                            </h3>

                            <div class="space-y-3" id="admins-list-container">
                                {adminsList.map(adm => (
                                    <div class="flex items-center justify-between p-4 rounded-xl bg-dark/70 border border-white/5">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-full bg-brand/10 border border-brand/30 flex items-center justify-center text-brand font-bold text-sm">
                                                {adm.username.charAt(0).toUpperCase()}
                                            </div>
                                            <div>
                                                <span class="text-white font-bold text-sm block">{adm.username}</span>
                                                <span class="text-[10px] text-gray-400 font-mono">Rôle : <strong class="text-brand">{adm.role}</strong></span>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-3">
                                            {adm.username !== currentUser.username && adm.username !== 'root' ? (
                                                <button 
                                                  class="delete-admin-btn text-red-400 hover:text-red-300 text-xs px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 transition"
                                                  data-id={adm.id}
                                                >
                                                    <i class="fa-solid fa-trash mr-1"></i> Supprimer
                                                </button>
                                            ) : (
                                                <span class="text-[10px] font-mono text-gray-500 uppercase px-2 py-1 bg-white/5 rounded">Protégé</span>
                                            )}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>

                    </div>
                </div>

                {/* =========================================================================
                    ONGLET 6 : RÈGLEMENT OFFICIEL PDF & DÉCOUPAGE EN CHAPITRES
                    ========================================================================= */}
                <div id="tab-panel-reglement" class="tab-panel hidden space-y-8">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="font-display text-2xl font-bold uppercase text-white">Règlement Officiel & Traitement PDF</h2>
                            <p class="text-xs text-gray-400">Téléversez le document PDF officiel et gérez les chapitres/articles affichés en accordéons</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                            <a href="/reglement" target="_blank" class="bg-white/10 hover:bg-white/20 text-white px-4 py-2.5 rounded-xl text-xs font-display uppercase tracking-wider transition inline-flex items-center gap-2 border border-white/10">
                                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                                <span>Voir page /reglement</span>
                            </a>
                            <button id="open-new-chapter-btn" class="bg-brand text-dark px-4 py-2.5 rounded-xl font-display uppercase tracking-wider text-xs font-bold hover:bg-white transition flex items-center gap-2 shadow-lg shadow-brand/20">
                                <i class="fa-solid fa-plus"></i>
                                <span>Ajouter un Article</span>
                            </button>
                        </div>
                    </div>

                    <!-- Carte 1 : Téléversement & Traitement du PDF -->
                    <div class="bg-cardBg/90 backdrop-blur-xl rounded-3xl p-6 sm:p-8 border border-white/10 shadow-2xl space-y-6">
                        <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 pb-6 border-b border-white/10">
                            <!-- État actuel du PDF -->
                            <div class="flex items-center gap-4">
                                <div class="w-14 h-14 rounded-2xl bg-brand/15 border border-brand/30 flex items-center justify-center text-brand text-2xl shrink-0 shadow-lg shadow-brand/10">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </div>
                                <div>
                                    <span class="text-[10px] font-display uppercase tracking-widest text-brand font-bold block">Document Actuel en Ligne</span>
                                    <strong class="text-white text-base block font-mono mt-0.5" id="reglement-current-filename">{reglement.pdfFilename || 'reglement.pdf'}</strong>
                                    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400 font-mono mt-1">
                                        <span class="bg-dark/80 px-2 py-0.5 rounded border border-white/5" id="reglement-current-size">
                                            {reglement.pdfSizeBytes ? `${Math.round(reglement.pdfSizeBytes / 1024)} Ko` : 'PDF'}
                                        </span>
                                        <span>•</span>
                                        <span id="reglement-current-date">Mis à jour le {new Date(reglement.lastUpdated).toLocaleDateString('fr-FR')}</span>
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-3">
                                <a 
                                  href={reglement.pdfUrl || '/medias/reglement.pdf'} 
                                  download={reglement.pdfFilename || 'reglement.pdf'} 
                                  class="bg-white/10 hover:bg-white/20 text-white text-xs px-4 py-2.5 rounded-xl transition flex items-center gap-2 border border-white/10"
                                >
                                    <i class="fa-solid fa-download text-xs"></i>
                                    <span>Télécharger actuel</span>
                                </a>
                                <a 
                                  href={reglement.pdfUrl || '/medias/reglement.pdf'} 
                                  target="_blank" 
                                  class="bg-brand/20 hover:bg-brand text-brand hover:text-dark text-xs px-4 py-2.5 rounded-xl transition font-semibold flex items-center gap-1.5"
                                >
                                    <i class="fa-solid fa-eye text-xs"></i>
                                    <span>Ouvrir PDF</span>
                                </a>
                            </div>
                        </div>

                        <!-- Formulaire d'upload de nouveau PDF -->
                        <form id="upload-reglement-form" class="space-y-4">
                            <label class="block text-xs uppercase tracking-wider text-gray-300 font-display font-bold">
                                Remplacer par un nouveau fichier PDF
                            </label>
                            
                            <div id="drop-zone-reglement" class="relative border-2 border-dashed border-white/20 hover:border-brand/60 rounded-3xl p-8 sm:p-10 text-center bg-dark/40 transition-colors duration-300 group">
                                <input 
                                  type="file" 
                                  id="upload-reglement-file" 
                                  accept="application/pdf,.pdf" 
                                  class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-20" 
                                  title="Cliquez ou déposez un fichier PDF"
                                />
                                <div class="pointer-events-none relative z-10 space-y-2">
                                    <i class="fa-solid fa-cloud-arrow-up text-3xl sm:text-4xl text-gray-400 group-hover:text-brand transition-colors block"></i>
                                    <p class="text-sm font-semibold text-white">
                                        Glissez-déposez votre PDF ici, ou <span class="text-brand underline">cliquez pour choisir</span>
                                    </p>
                                    <div id="selected-reglement-filename" class="text-xs text-gray-400 font-mono py-1 px-3 bg-white/5 rounded-lg inline-block">
                                        Format PDF uniquement (ex: reglement-2026.pdf)
                                    </div>
                                </div>
                            </div>

                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-2">
                                <div class="flex items-center gap-2.5">
                                    <input type="checkbox" id="reglement-auto-parse" checked class="w-4 h-4 accent-brand rounded cursor-pointer" />
                                    <label for="reglement-auto-parse" class="text-xs text-gray-300 cursor-pointer select-none">
                                        Analyser et <strong>découper automatiquement le texte en chapitres / articles</strong>
                                    </label>
                                </div>

                                <button 
                                  type="submit" 
                                  id="upload-reglement-submit-btn" 
                                  class="bg-brand text-dark font-display font-bold uppercase tracking-wider text-xs px-6 py-3.5 rounded-xl hover:bg-white transition shadow-lg shadow-brand/20 flex items-center justify-center gap-2 self-start sm:self-auto"
                                >
                                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                                    <span>Traiter & Mettre en Ligne</span>
                                </button>
                            </div>
                        </form>
                    </div>

                    <!-- Carte 2 : Liste des Chapitres Actifs -->
                    <div class="space-y-4">
                        <div class="flex items-center justify-between">
                            <h3 class="font-display text-xl font-bold uppercase text-white flex items-center gap-2">
                                <span>Articles & Chapitres Actifs</span>
                                <span class="text-xs font-mono font-normal text-brand" id="admin-chapters-count">({reglement.chapters.length} articles)</span>
                            </h3>
                            <span class="text-xs text-gray-400 font-mono hidden sm:inline">Ces articles sont affichés sous forme d'accordéons sur la page /reglement</span>
                        </div>

                        <div class="space-y-3" id="admin-chapters-list">
                            {reglement.chapters.map((ch, idx) => (
                                <div class="bg-cardBg rounded-2xl p-5 border border-white/10 hover:border-brand/30 transition flex flex-col sm:flex-row sm:items-center justify-between gap-4" id={`chapter-row-${ch.id}`}>
                                    <div class="space-y-1.5 flex-1 min-w-0">
                                        <div class="flex items-center gap-3">
                                            <span class="bg-brand/15 text-brand font-display font-bold uppercase text-xs px-2.5 py-1 rounded-lg border border-brand/30 shrink-0">
                                                {ch.number}
                                            </span>
                                            <h4 class="font-display text-base font-bold text-white uppercase truncate">
                                                {ch.title}
                                            </h4>
                                        </div>
                                        <p class="text-xs text-gray-400 line-clamp-2 leading-relaxed">
                                            {ch.content}
                                        </p>
                                    </div>

                                    <div class="flex items-center gap-2 shrink-0">
                                        <button 
                                          class="edit-chapter-btn text-xs px-3 py-2 bg-brand/20 hover:bg-brand text-brand hover:text-dark rounded-xl transition font-semibold flex items-center gap-1.5"
                                          data-chapter={JSON.stringify(ch)}
                                        >
                                            <i class="fa-solid fa-pen"></i>
                                            <span>Modifier</span>
                                        </button>
                                        <button 
                                          class="delete-chapter-btn text-xs px-3 py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-xl transition flex items-center gap-1"
                                          data-id={ch.id}
                                          data-title={ch.title}
                                          title="Supprimer cet article"
                                        >
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

            </div>
        )}

    </div>

    {/* =========================================================================
        MODALE 1 : CRÉATION / MODIFICATION D'UNE ÉDITION
        ========================================================================= */}
    <div id="edition-modal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-xl hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
        <div class="bg-cardBg rounded-3xl p-6 sm:p-8 max-w-2xl w-full border border-white/10 shadow-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-6">

---
import Layout from '../layouts/Layout.astro';

const title = "Inscriptions & Tarifs 2027 | Trail des Mines - Champagney";
const description = "Inscrivez-vous au Trail des Mines 2027 : réservez votre dossard pour Les Gueules Noires (52 km), Les Terrils (28 km), Les Galibots (13 km) ou la Randonnée solidaire.";
---

<Layout title={title} description={description} loadLeaflet={false} loadChart={false}>

<!-- Header / Hero Inscriptions avec Compteur -->
    <header class="pt-32 pb-16 md:pt-44 md:pb-24 px-4 relative overflow-hidden bg-gradient-to-b from-[#0a1214] via-dark to-dark text-center">
        <div class="max-w-5xl mx-auto relative z-10">
            <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand/10 border border-brand/20 text-brand text-xs uppercase tracking-widest font-semibold mb-6 hero-anim">
                <i class="fa-solid fa-clock"></i> Inscriptions Bientôt Ouvertes • Édition 2027
            </div>
            <h1 class="font-display text-4xl sm:text-6xl md:text-7xl font-bold uppercase tracking-tight text-white mb-6 hero-anim">
                Prenez Votre <span class="text-brand">Dossard</span>
            </h1>
            <p class="text-gray-300 text-sm md:text-lg max-w-2xl mx-auto font-light leading-relaxed mb-12 hero-anim">
                Rejoignez les 1 200 coureurs au départ du bassin minier de Champagney. Choisissez votre défi, validez votre justificatif de santé et préparez-vous pour une immersion totale dans les Vosges Saônoises.
            </p>

            <!-- Compteur Dynamique (piloté par main.js) -->
            <div class="inline-flex flex-wrap items-center justify-center gap-3 sm:gap-6 bg-cardBg/80 backdrop-blur-xl px-6 py-6 rounded-3xl border border-white/10 shadow-2xl hero-anim">
                <div class="flex flex-col items-center min-w-[65px] sm:min-w-[85px]">
                    <span id="cd-days" class="font-display text-3xl sm:text-5xl font-bold text-brand leading-none">00</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-gray-400 mt-2 font-medium">Jours</span>
                </div>
                <span class="text-2xl sm:text-3xl text-white/20 font-light">:</span>
                <div class="flex flex-col items-center min-w-[65px] sm:min-w-[85px]">
                    <span id="cd-hours" class="font-display text-3xl sm:text-5xl font-bold text-white leading-none">00</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-gray-400 mt-2 font-medium">Heures</span>
                </div>
                <span class="text-2xl sm:text-3xl text-white/20 font-light">:</span>
                <div class="flex flex-col items-center min-w-[65px] sm:min-w-[85px]">
                    <span id="cd-minutes" class="font-display text-3xl sm:text-5xl font-bold text-white leading-none">00</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-gray-400 mt-2 font-medium">Minutes</span>
                </div>
                <span class="text-2xl sm:text-3xl text-white/20 font-light">:</span>
                <div class="flex flex-col items-center min-w-[65px] sm:min-w-[85px]">
                    <span id="cd-seconds" class="font-display text-3xl sm:text-5xl font-bold text-brand leading-none">00</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-gray-400 mt-2 font-medium">Secondes</span>
                </div>
            </div>

            <!-- Notice Plateforme Externe -->
            <div class="mt-8 max-w-2xl mx-auto bg-brand/10 border border-brand/30 rounded-2xl p-4 sm:p-5 flex items-center gap-3.5 text-left hero-anim shadow-lg">
                <div class="w-10 h-10 rounded-xl bg-brand text-dark flex items-center justify-center shrink-0 text-sm font-bold">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                </div>
                <div>
                    <h4 class="font-display text-xs uppercase font-bold text-brand tracking-wider">Plateforme d'inscription externe</h4>
                    <p class="text-gray-300 text-xs font-light leading-relaxed mt-0.5">
                        Les réservations de dossards seront gérées sur un site web partenaire officiel dédié. L'ouverture officielle sera annoncée très prochainement.
                    </p>
                </div>
            </div>
        </div>
    </header>

    <!-- Grille des Épreuves & Tarifs -->
    <main class="max-w-7xl mx-auto px-4 pb-24">
        
        <div class="text-center mb-12 gsap-fade-up">
            <span class="text-brand font-display text-xs uppercase tracking-widest block mb-2">Choisissez Votre Format</span>
            <h2 class="font-display text-3xl sm:text-4xl font-bold uppercase text-white">3 Courses Officielles</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 mb-20">

            <!-- Format 1 : Galibots (13 km) -->
            <div class="bg-cardBg/70 backdrop-blur-xl rounded-3xl p-6 sm:p-8 border border-white/10 shadow-xl flex flex-col justify-between course-card group hover:border-brand/40 transition-all duration-300">
                <div>
                    <div class="flex justify-between items-start mb-4">
                        <span class="px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold uppercase tracking-widest text-gray-300">Format Découverte</span>
                        <span class="font-display text-2xl font-bold text-brand">16 €</span>
                    </div>
                    <h3 class="font-display text-2xl font-bold uppercase text-white group-hover:text-brand transition-colors mb-1">Les Galibots</h3>
                    <p class="text-xs text-gray-400 mb-6 font-light">Une course rapide et exigeante qui vous fera prendre de la hauteur sur Champagney en passant par les chemins forestiers.</p>
                    
                    <div class="space-y-3 pb-6 border-t border-white/10 pt-4 text-xs">
                        <div class="flex justify-between py-1"><span class="text-gray-400">Distance</span><span class="font-bold text-white">13 KM</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Dénivelé positif</span><span class="font-bold text-brand">550 M D+</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Heure de départ</span><span class="font-bold text-white">09h30</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Ravitaillements</span><span class="font-bold text-white">1 en course + Arrivée</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Âge minimum</span><span class="font-bold text-white">Cadets (16 ans)</span></div>
                    </div>

                    <!-- Jauge de remplissage -->
                    <div class="mt-6 mb-6">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="text-gray-400 font-semibold">Dossards restants</span>
                            <span class="text-brand font-bold">90 / 400</span>
                        </div>
                        <div class="w-full h-2 bg-dark/60 rounded-full overflow-hidden">
                            <div class="bg-brand h-full rounded-full" style="width: 78%;"></div>
                        </div>
                        <span class="text-[10px] text-gray-500 mt-1 block text-right">78% réservé</span>
                    </div>
                </div>

                <button type="button" class="btn-registration-trigger w-full text-center bg-white/10 hover:bg-brand hover:text-dark py-3.5 rounded-xl font-display uppercase tracking-widest font-bold text-xs transition-all shadow-md inline-flex items-center justify-center gap-2 group/btn cursor-pointer">
                    <span>S'inscrire (13 KM)</span>
                    <i class="fa-solid fa-arrow-right text-[10px] group-hover/btn:translate-x-1 transition-transform"></i>
                </button>
            </div>

            <!-- Format 2 : Terrils (28 km) -->
            <div class="bg-cardBg/90 backdrop-blur-xl rounded-3xl p-6 sm:p-8 border-2 border-brand/60 shadow-2xl flex flex-col justify-between course-card group relative transform lg:-translate-y-2">
                <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-brand text-dark text-[10px] font-bold uppercase tracking-widest px-4 py-1 rounded-full shadow-lg">
                    Le Plus Populaire
                </div>
                <div>
                    <div class="flex justify-between items-start mb-4 mt-2">
                        <span class="px-3 py-1 bg-brand/20 border border-brand/30 rounded-full text-[10px] font-bold uppercase tracking-widest text-brand">Épreuve Historique</span>
                        <span class="font-display text-2xl font-bold text-brand">28 €</span>
                    </div>
                    <h3 class="font-display text-2xl font-bold uppercase text-white group-hover:text-brand transition-colors mb-1">Les Terrils</h3>
                    <p class="text-xs text-gray-400 mb-6 font-light">Un tracé qui vous emmènera à Fresse en passant par Plancher-Bas avant de revenir sur Champagney par les sentiers et singles des Vosges Saônoise.</p>
                    
                    <div class="space-y-3 pb-6 border-t border-white/10 pt-4 text-xs">
                        <div class="flex justify-between py-1"><span class="text-gray-400">Distance</span><span class="font-bold text-white">28 KM</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Dénivelé positif</span><span class="font-bold text-brand">1 380 M D+</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Heure de départ</span><span class="font-bold text-white">09h00</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Ravitaillements</span><span class="font-bold text-white">2 en course + Arrivée</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Âge minimum</span><span class="font-bold text-white">Espoirs (20 ans)</span></div>
                    </div>

                    <!-- Jauge de remplissage -->
                    <div class="mt-6 mb-6">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="text-gray-400 font-semibold">Dossards restants</span>
                            <span class="text-brand font-bold">42 / 450</span>
                        </div>
                        <div class="w-full h-2 bg-dark/60 rounded-full overflow-hidden">
                            <div class="bg-brand h-full rounded-full" style="width: 91%;"></div>
                        </div>
                        <span class="text-[10px] text-brand mt-1 block text-right font-bold">91% réservé - Bientôt complet</span>
                    </div>
                </div>

                <button type="button" class="btn-registration-trigger w-full text-center bg-brand text-dark hover:bg-white py-3.5 rounded-xl font-display uppercase tracking-widest font-bold text-xs transition-all shadow-lg inline-flex items-center justify-center gap-2 group/btn cursor-pointer">
                    <span>S'inscrire (28 KM)</span>
                    <i class="fa-solid fa-arrow-right text-[10px] group-hover/btn:translate-x-1 transition-transform"></i>
                </button>
            </div>

            <!-- Format 3 : Gueules Noires (52 km) -->
            <div class="bg-cardBg/70 backdrop-blur-xl rounded-3xl p-6 sm:p-8 border border-white/10 shadow-xl flex flex-col justify-between course-card group hover:border-brand/40 transition-all duration-300">
                <div>
                    <div class="flex justify-between items-start mb-4">
                        <span class="px-3 py-1 bg-cyan-500/10 border border-cyan-500/20 rounded-full text-[10px] font-bold uppercase tracking-widest text-cyan-400">Épreuve Reine • 2 pts ITRA</span>
                        <span class="font-display text-2xl font-bold text-brand">45 €</span>
                    </div>
                    <h3 class="font-display text-2xl font-bold uppercase text-white group-hover:text-brand transition-colors mb-1">Les Gueules Noires</h3>
                    <p class="text-xs text-gray-400 mb-6 font-light">Empruntez un itinéraire exigeant, vous hissant au sommet de la Planche des Belles Filles. Avec ses aspects techniques et vallonnés, ce parcours laissera une empreinte mémorable sur vos mollets.</p>
                    
                    <div class="space-y-3 pb-6 border-t border-white/10 pt-4 text-xs">
                        <div class="flex justify-between py-1"><span class="text-gray-400">Distance</span><span class="font-bold text-white">52 KM</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Dénivelé positif</span><span class="font-bold text-brand">2 500 M D+</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Heure de départ</span><span class="font-bold text-white">07h00</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Ravitaillements</span><span class="font-bold text-white">4 en course + Arrivée</span></div>
                        <div class="flex justify-between py-1"><span class="text-gray-400">Âge minimum</span><span class="font-bold text-white">Seniors (20 ans)</span></div>
                    </div>

                    <!-- Jauge de remplissage -->
                    <div class="mt-6 mb-6">
                        <div class="flex justify-between text-xs mb-1.5">
                            <span class="text-gray-400 font-semibold">Dossards restants</span>
                            <span class="text-brand font-bold">66 / 250</span>
                        </div>
                        <div class="w-full h-2 bg-dark/60 rounded-full overflow-hidden">
                            <div class="bg-brand h-full rounded-full" style="width: 74%;"></div>
                        </div>
                        <span class="text-[10px] text-gray-500 mt-1 block text-right">74% réservé</span>
                    </div>
                </div>

                <button type="button" class="btn-registration-trigger w-full text-center bg-white/10 hover:bg-brand hover:text-dark py-3.5 rounded-xl font-display uppercase tracking-widest font-bold text-xs transition-all shadow-md inline-flex items-center justify-center gap-2 group/btn cursor-pointer">
                    <span>S'inscrire (52 KM)</span>
                    <i class="fa-solid fa-arrow-right text-[10px] group-hover/btn:translate-x-1 transition-transform"></i>
                </button>
            </div>

        </div>

        <!-- Ce qui est inclus dans votre dossard -->
        <section class="bg-cardBg/40 backdrop-blur-xl rounded-3xl p-8 sm:p-12 border border-white/10 mb-20 gsap-fade-up">
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="text-brand font-display text-xs uppercase tracking-widest block mb-2">Prestations Coureurs</span>
                <h2 class="font-display text-3xl font-bold uppercase text-white">Inclus Dans Chaque Inscription</h2>
                <p class="text-gray-400 text-xs sm:text-sm mt-2">Nous mettons un point d'honneur à offrir une expérience coureur chaleureuse, éco-responsable et complète.</p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 text-center">
                <div class="p-4 bg-dark/50 rounded-2xl border border-white/5">
                    <i class="fa-solid fa-stopwatch text-2xl text-brand mb-2"></i>
                    <span class="font-display uppercase text-xs font-bold text-white block">Chrono RFID</span>
                    <span class="text-[10px] text-gray-400">Temps officiel au centième</span>
                </div>
                <div class="p-4 bg-dark/50 rounded-2xl border border-white/5">
                    <i class="fa-solid fa-medal text-2xl text-brand mb-2"></i>
                    <span class="font-display uppercase text-xs font-bold text-white block">Médaille Bois PEFC</span>
                    <span class="text-[10px] text-gray-400">Gravure locale artisanale</span>
                </div>
                <div class="p-4 bg-dark/50 rounded-2xl border border-white/5">
                    <i class="fa-solid fa-apple-whole text-2xl text-brand mb-2"></i>
                    <span class="font-display uppercase text-xs font-bold text-white block">Buffet Terroir</span>
                    <span class="text-[10px] text-gray-400">Comptoir Haute-Saône</span>
                </div>
                <div class="p-4 bg-dark/50 rounded-2xl border border-white/5">
                    <i class="fa-solid fa-beer-mug-empty text-2xl text-brand mb-2"></i>
                    <span class="font-display uppercase text-xs font-bold text-white block">Bière Finisher</span>
                    <span class="text-[10px] text-gray-400">Brasserie locale artisanale</span>
                </div>
                <div class="p-4 bg-dark/50 rounded-2xl border border-white/5">
                    <i class="fa-solid fa-shower text-2xl text-brand mb-2"></i>
                    <span class="font-display uppercase text-xs font-bold text-white block">Douches Chaudes</span>
                    <span class="text-[10px] text-gray-400">Vestiaires et consignes</span>
                </div>
                <div class="p-4 bg-dark/50 rounded-2xl border border-white/5">
                    <i class="fa-solid fa-camera text-2xl text-brand mb-2"></i>
                    <span class="font-display uppercase text-xs font-bold text-white block">Photos HD Gratuites</span>
                    <span class="text-[10px] text-gray-400">Téléchargement libre</span>
                </div>
            </div>
        </section>

        <!-- Règlementation Médicale FFA & Parcours Prévention Santé -->
        <section class="bg-gradient-to-r from-cardBg via-[#1c3338] to-cardBg rounded-3xl p-8 sm:p-12 border border-brand/30 shadow-2xl mb-20 gsap-fade-up">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                <div class="lg:col-span-8">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-brand/20 text-brand text-xs uppercase font-bold tracking-widest rounded-full mb-4">
                        <i class="fa-solid fa-heart-pulse"></i> Justificatif Médical Obligatoire
                    </div>
                    <h2 class="font-display text-2xl sm:text-4xl font-bold uppercase text-white mb-4">
                        Le PPS (Parcours Prévention Santé) FFA
                    </h2>
                    <p class="text-gray-300 text-xs sm:text-sm font-light leading-relaxed mb-4">
                        Conformément à la nouvelle réglementation de la Fédération Française d'Athlétisme (FFA) et à la loi sport, le certificat médical traditionnel n'est plus obligatoire pour les participants majeurs.
                    </p>
                    <ul class="space-y-2 text-xs sm:text-sm text-gray-300 font-light mb-6">
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand"></i> Réalisez votre module PPS en 3 minutes sur <strong class="text-white">pps.athle.fr</strong></li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand"></i> L'attestation générée doit être datée de moins de 3 mois au jour de l'épreuve (valable à partir du 16 février 2027).</li>
                        <li class="flex items-center gap-2"><i class="fa-solid fa-check text-brand"></i> Les licenciés FFA (Compétition, Running, Pass) renseignent simplement leur numéro de licence valide 2026-2027.</li>
                    </ul>
                </div>
                <div class="lg:col-span-4 flex flex-col gap-3">
                    <a href="https://pps.athle.fr" target="_blank" rel="noopener" class="w-full text-center bg-brand text-dark hover:bg-white py-4 rounded-2xl font-display uppercase tracking-widest font-bold text-xs transition-all shadow-[0_10px_25px_rgba(176,190,66,0.3)]">
                        Générer mon attestation PPS (FFA) <i class="fa-solid fa-arrow-up-right-from-square ml-1"></i>
                    </a>
                    <a href="/reglement" class="w-full text-center bg-white/10 hover:bg-white/20 text-white py-3.5 rounded-2xl font-display uppercase tracking-widest font-semibold text-xs transition-all">
                        Consulter le Règlement Complet
                    </a>
                </div>
            </div>
        </section>

        <!-- Retrait des Dossards & Modalités -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 gsap-fade-up">
            <div class="bg-cardBg/60 rounded-3xl p-8 border border-white/10">
                <h3 class="font-display text-xl font-bold uppercase text-white mb-4 flex items-center gap-3">
                    <i class="fa-solid fa-calendar-check text-brand"></i> Horaires Retrait Dossards
                </h3>
                <div class="space-y-4 text-xs sm:text-sm text-gray-300">
                    <div class="p-4 bg-dark/40 rounded-2xl border border-white/5">
                        <strong class="text-brand uppercase block mb-1">Samedi 15 Mai 2027</strong>
                        <span>De 15h00 à 19h00 — Complexe Sportif de Champagney (évitez l'attente du dimanche matin !)</span>
                    </div>
                    <div class="p-4 bg-dark/40 rounded-2xl border border-white/5">
                        <strong class="text-brand uppercase block mb-1">Dimanche 16 Mai 2027 (Jour de course)</strong>
                        <span>À partir de 05h30 et jusqu'à 30 minutes avant le départ de votre course respective.</span>
                    </div>
                </div>
            </div>

            <div class="bg-cardBg/60 rounded-3xl p-8 border border-white/10">
                <h3 class="font-display text-xl font-bold uppercase text-white mb-4 flex items-center gap-3">
                    <i class="fa-solid fa-shield-halved text-brand"></i> Garantie Annulation & Cession
                </h3>
                <div class="space-y-4 text-xs sm:text-sm text-gray-300">
                    <div class="p-4 bg-dark/40 rounded-2xl border border-white/5">
                        <strong class="text-brand uppercase block mb-1">Option Sérénité (3 €)</strong>
                        <span>Remboursement à 100% de votre inscription en cas de blessure ou motif médical justifié jusqu'au 10 mai 2027.</span>
                    </div>
                    <div class="p-4 bg-dark/40 rounded-2xl border border-white/5">
                        <strong class="text-brand uppercase block mb-1">Changement de coureur gratuit</strong>
                        <span>Possibilité de céder son dossard à un autre coureur sans surcoût jusqu'au 10 mai 2027 via la plateforme officielle.</span>
                    </div>
                </div>
            </div>
        </section>

    </main>

    <!-- Mega Footer -->

</Layout>

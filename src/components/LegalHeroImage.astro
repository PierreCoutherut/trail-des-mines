---
interface Props {
  src: string;
  alt?: string;
  position?: string;
}

const { src, alt = '', position = '50% 50%' } = Astro.props;
---

<div class="legal-hero-image">
  <img src={src} alt={alt} width="1600" height="900" loading="eager" fetchpriority="high" style={`object-position: ${position};`} />
  <div aria-hidden="true"></div>
</div>

<style>
  .legal-hero-image { position: relative; width: 100%; aspect-ratio: 16 / 6; min-height: 11rem; max-height: 22rem; margin-bottom: 2rem; overflow: hidden; border: 1px solid rgba(255,255,255,.1); border-radius: 1.5rem; background: #122226; }
  .legal-hero-image img { width: 100%; height: 100%; object-fit: cover; }
  .legal-hero-image div { position: absolute; inset: 0; background: linear-gradient(to top, rgba(7,16,19,.72), rgba(7,16,19,.06) 55%, rgba(7,16,19,.18)); }
  @media (max-width: 639px) { .legal-hero-image { aspect-ratio: 4 / 3; min-height: 0; border-radius: 1rem; } }
</style>

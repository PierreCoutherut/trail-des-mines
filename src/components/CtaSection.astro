---
// CtaSection.astro - Grand bandeau d'appel à l'action avec effet Marvel Flip-Book au survol
---

<section id="cta-section" class="min-h-[24rem] h-[48svh] md:min-h-[30rem] md:h-[58vh] bg-brand text-dark relative flex items-center justify-center overflow-hidden z-20 transition-colors duration-500">
    <!-- Texture Topographique subtile en filigrane minéral (faible opacité) -->
    <div class="topo-texture-dark pointer-events-none" aria-hidden="true"></div>

    <!-- Calque Marvel : Diaporama dynamique haute vélocité (actif au survol du bouton) -->
    <div id="cta-marvel-bg" class="absolute inset-0 z-0 opacity-0 pointer-events-none transition-opacity duration-500">
        <div id="cta-marvel-img" class="w-full h-full bg-cover bg-center transition-transform duration-700 filter brightness-105 contrast-125"></div>
        <!-- Masque d'assombrissement et dégradé cinématique Marvel -->
        <div class="absolute inset-0 bg-dark/65 backdrop-blur-[0.5px]"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-dark via-dark/30 to-dark/80"></div>

    </div>

    <!-- Contenu Central (seul le bouton ci-dessous est cliquable) -->
    <div class="relative z-10 w-full max-w-[100vw] flex flex-col items-center justify-center text-center px-4 sm:px-6 pointer-events-none">
        <!-- Badge style générique Marvel -->
        <div id="cta-marvel-badge" class="inline-flex max-w-full items-center justify-center gap-2 px-3 sm:px-3.5 py-1.5 rounded bg-dark/90 border border-white/20 text-white font-display uppercase tracking-[0.16em] sm:tracking-[0.3em] text-[9px] sm:text-[10px] md:text-xs mb-4 transition-all duration-300 shadow-lg">
            <span class="w-2 h-2 rounded-full bg-brand animate-pulse"></span>
            <span>6ème Édition • 16 Mai 2027</span>
        </div>

        <h2 id="cta-title" class="w-full font-display text-[clamp(2.5rem,12vw,10rem)] font-bold uppercase leading-[.9] text-dark transition-all duration-200 select-none tracking-[-0.04em] whitespace-nowrap">
            S'inscrire
        </h2>
        
        <!-- Bouton d'inscription exclusif (seul élément interactif pour s'inscrire) -->
        <button type="button" data-open-registration-modal id="cta-btn" class="btn-registration-trigger pointer-events-auto min-h-12 max-w-full inline-flex items-center justify-center gap-2.5 sm:gap-3.5 mt-6 md:mt-8 px-5 sm:px-8 md:px-10 py-3.5 sm:py-4 rounded-full bg-dark text-white hover:bg-brand hover:text-dark border-2 border-white/20 hover:border-brand font-sans font-bold uppercase tracking-wider text-[11px] md:text-sm transition-all duration-200 shadow-2xl hover:scale-105 active:scale-95 cursor-pointer group hover:shadow-[0_0_40px_rgba(176,190,66,0.6)]" aria-label="Je prends mon dossard pour le Trail des Mines 2027">
            <span>Je prends mon dossard</span>
            <i class="fa-solid fa-arrow-right text-xs transition-transform duration-200 group-hover:translate-x-2"></i>
        </button>
    </div>
</section>

<!-- Script Effet Marvel Haute Vélocité (900ms) au Survol du Bouton -->
<script is:inline>
  (() => {
    function initCta() {
      const button = document.getElementById('cta-btn');
      const backdrop = document.getElementById('cta-marvel-bg');
      const image = document.getElementById('cta-marvel-img');
      const title = document.getElementById('cta-title');
      if (!button || !backdrop || !image) return;
      const images = [
        '/medias/Index/Pierre-Coutherut_TDM-2024-2.jpg',
        '/medias/Index/Pierre-Coutherut_TDM-2024-48.jpg',
        '/medias/Index/Pierre-Coutherut_TDM-2024-71.jpg',
        '/medias/Index/Pierre-Coutherut_TDM-2024-79.jpg',
        '/medias/Index/Pierre-Coutherut_TDM-2024-220.jpg',
        '/medias/Index/Elodie-Bermond_IMG_6221-original.webp'
      ];
      const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
      let timer;
      let index = -1;
      let preloaded = false;
      function nextImage() {
        index = (index + 1) % images.length;
        image.style.backgroundImage = 'url("' + images[index] + '")';
        image.style.transform = index % 2 ? 'scale(1.06)' : 'scale(1.02)';
      }
      function start() {
        if (timer || preference.matches) return;
        if (!preloaded) {
          images.forEach(src => { const img = new Image(); img.src = src; });
          preloaded = true;
        }
        nextImage();
        backdrop.classList.replace('opacity-0', 'opacity-100');
        title?.classList.replace('text-dark', 'text-white');
        timer = setInterval(nextImage, 900);
      }
      function stop() {
        clearInterval(timer);
        timer = undefined;
        backdrop.classList.replace('opacity-100', 'opacity-0');
        title?.classList.replace('text-white', 'text-dark');
      }
      button.addEventListener('mouseenter', start);
      button.addEventListener('mouseleave', stop);
      button.addEventListener('focus', start);
      button.addEventListener('blur', stop);
      button.addEventListener('click', stop);
      preference.addEventListener('change', stop);
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
      new IntersectionObserver(entries => { if (!entries[0].isIntersecting) stop(); }).observe(button);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCta);
    else initCta();
  })();
</script>

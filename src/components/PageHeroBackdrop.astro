---
interface Props {
  src: string;
  alt?: string;
  position?: string;
  mobilePosition?: string;
  srcset?: string;
  sizes?: string;
  width?: number;
  height?: number;
}

const { src, alt = '', position = '50% 50%', mobilePosition = position, srcset, sizes, width = 2000, height = 1396 } = Astro.props;
---

<img
  src={src}
  srcset={srcset}
  sizes={srcset ? sizes || '100vw' : undefined}
  alt={alt}
  width={width}
  height={height}
  loading="eager"
  fetchpriority="high"
  class="page-hero-image absolute inset-0 h-full w-full object-cover"
  style={`--hero-position: ${position}; --hero-mobile-position: ${mobilePosition};`}
/>
<div class="absolute inset-0 bg-gradient-to-b from-[#071013]/75 via-[#071013]/60 to-dark" aria-hidden="true"></div>
<div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_42%,transparent_0%,rgba(5,12,14,.2)_48%,rgba(5,12,14,.78)_100%)]" aria-hidden="true"></div>
<style>
  .page-hero-image { object-position: var(--hero-position); }
  @media (max-width: 640px) { .page-hero-image { object-position: var(--hero-mobile-position); } }
</style>

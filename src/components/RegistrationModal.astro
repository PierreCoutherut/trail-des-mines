---
---
<dialog id="registration-modal" aria-labelledby="reg-modal-title" aria-describedby="reg-modal-description" class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-lg max-h-[90svh] overflow-y-auto rounded-3xl border border-brand/40 bg-[#0f1d21] p-6 sm:p-9 text-white text-center shadow-2xl">
  <div class="modal-card flex flex-col items-center">
    <i class="fa-solid fa-ticket text-4xl text-brand mb-6" aria-hidden="true"></i>
    <p class="text-brand text-xs uppercase tracking-widest mb-3">16 mai 2027 · Champagney</p>
    <h2 id="reg-modal-title" class="font-display text-3xl sm:text-4xl font-bold uppercase leading-tight mb-4">Inscriptions bientôt ouvertes</h2>
    <p id="reg-modal-description" class="text-gray-300 text-sm leading-relaxed mb-8">Encore un peu de patience… La prochaine édition du Trail des Mines se prépare. On vous dévoile la suite très bientôt.</p>
    <button type="button" class="modal-close-btn w-full py-3.5 px-6 rounded-full bg-brand text-dark hover:bg-white font-display uppercase tracking-widest text-xs font-bold transition-colors cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white">Je patiente encore ...</button>
  </div>
</dialog>
<style>
  dialog::backdrop { background: rgb(10 18 20 / 88%); backdrop-filter: blur(8px); }
  dialog[open] { animation: registration-enter 220ms cubic-bezier(.16, 1, .3, 1); }
  @keyframes registration-enter { from { opacity: 0; transform: scale(.96); } to { opacity: 1; transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { dialog[open] { animation: none; } }
</style>
<script is:inline>
  (() => {
    const modal = document.getElementById('registration-modal');
    if (!modal) return;
    function openModal() {
      window.closeMobileMenu?.();
      if (modal.open) return;
      modal.showModal();
      document.body.classList.add('overflow-hidden');
      window.lenis?.stop();
    }
    function closeModal() { modal.close(); }
    modal.addEventListener('close', () => {
      document.body.classList.remove('overflow-hidden');
      window.lenis?.start();
    });
    modal.querySelector('.modal-close-btn').addEventListener('click', closeModal);
    modal.addEventListener('click', (event) => {
      const bounds = modal.getBoundingClientRect();
      if (event.target === modal && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) closeModal();
    });
    window.openRegistrationModal = openModal;
    window.closeRegistrationModal = closeModal;
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (event.target.closest('.btn-registration-trigger, [data-open-registration-modal], a[href="/inscription"]')) {
        event.preventDefault();
        openModal();
      }
    });
  })();
</script>

---
// Footer.astro - Mega sitemap footer with Logo.png & oversized background typography
---
<footer class="bg-[#0a1214] pt-16 md:pt-24 flex flex-col relative z-20 overflow-hidden" role="contentinfo">


  <!-- Logo & Introduction Footer -->
  <div class="w-full max-w-7xl mx-auto px-4 mb-12 flex flex-col sm:flex-row items-center justify-between gap-6 pb-8 border-b border-white/10 relative z-10">
    <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="Accueil Trail des Mines">
      <img src="/medias/Logo.png" alt="Logo Trail des Mines" class="h-12 md:h-14 w-auto object-contain transition-transform duration-300 group-hover:scale-105 drop-shadow-md" />
      <div>
        <span class="font-display font-bold text-lg md:text-xl uppercase tracking-widest text-white block">
          Trail des <span class="text-brand">Mines</span>
        </span>
        <span class="text-[10px] uppercase tracking-widest text-gray-400">6ème Édition • 16 Mai 2027 • Champagney</span>
      </div>
    </a>
    <div class="flex items-center gap-4">
      <span class="text-xs uppercase tracking-widest text-gray-400 font-medium">Une organisation</span>
      <span class="px-3.5 py-1.5 bg-brand/10 border border-brand/20 rounded-full text-brand text-xs font-bold uppercase tracking-wider">Run in Champagney</span>
    </div>
  </div>

  <!-- Sitemap Grid -->
  <div class="w-full max-w-7xl mx-auto px-4 mb-16 md:mb-24 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 relative z-10">
    
    <!-- Colonne 1 : Les Courses -->
    <div class="flex flex-col gap-3">
      <h4 class="font-display text-white text-sm md:text-base uppercase tracking-[0.2em] mb-4">Les Courses</h4>
      <a href="/parcours" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Tous les Parcours</a>
      <a href="/galibots" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Galibots (13 km)</a>
      <a href="/terrils" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Terrils (28 km)</a>
      <a href="/gueules-noires" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Gueules Noires (52 km)</a>
      <a href="/autres" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Autres formats</a>
    </div>

    <!-- Colonne 2 : Infos Pratiques -->
    <div class="flex flex-col gap-3">
      <h4 class="font-display text-white text-sm md:text-base uppercase tracking-[0.2em] mb-4">Infos Pratiques</h4>
      <a href="/infos-pratiques" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Guide Général</a>
      <a href="/reglement" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Règlement</a>
      <a href="/resultats-medias" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Résultats & Médias</a>
      <a href="/editions-precedentes" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Éditions Précédentes</a>
      <a href="/preparer-mon-trail" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Préparer mon trail</a>
    </div>

    <!-- Colonne 3 : L'Association -->
    <div class="flex flex-col gap-3">
      <h4 class="font-display text-white text-sm md:text-base uppercase tracking-[0.2em] mb-4">L'Association</h4>
      <a href="/a-propos" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">À propos</a>
      <a href="/association" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Run in Champagney</a>
      <a href="/benevoles" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Bénévoles</a>
      <a href="/eco-engagement" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Éco-engagement & Territoire</a>
      <a href="/partenaires" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Partenaires & Sponsors</a>
      <a href="/dossard-solidaire" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Dossard Solidaire</a>
    </div>

    <!-- Colonne 4 : Raccourcis & Légal -->
    <div class="flex flex-col gap-3">
      <h4 class="font-display text-white text-sm md:text-base uppercase tracking-[0.2em] mb-4">Raccourcis</h4>
      <a href="/inscription" class="btn-registration-trigger text-brand hover:text-white text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors mb-2 font-bold cursor-pointer">S'inscrire</a>
      <a href="/" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Page d'accueil</a>
      <a href="/contact" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Contact</a>
      <a href="/presse" class="text-gray-500 hover:text-brand text-[10px] md:text-xs uppercase tracking-widest font-sans transition-colors">Presse</a>
      <div class="mt-4 flex flex-col gap-2">
        <a href="/mentions-legales" class="text-gray-600 hover:text-white text-[9px] uppercase tracking-wider font-sans transition-colors">Mentions légales</a>
        <a href="/politique-confidentialite" class="text-gray-600 hover:text-white text-[9px] uppercase tracking-wider font-sans transition-colors">Politique de confidentialité</a>
        <a href="/declaration-accessibilite" class="text-gray-600 hover:text-white text-[9px] uppercase tracking-wider font-sans transition-colors">Déclaration d'accessibilité</a>
      </div>
    </div>
  </div>

  <!-- Copyright -->
  <div class="w-full text-center z-10 px-4 mb-4">
    <p class="text-gray-700 text-[9px] uppercase tracking-widest font-sans">© 2027 Association Run in Champagney - Tous droits réservés</p>
  </div>

  <!-- Filigrane Décoratif Géant -->
  <div aria-hidden="true" class="w-full relative translate-y-[28%] md:translate-y-[22%] pointer-events-none select-none text-center overflow-hidden">
    <div class="font-display text-[22vw] md:text-[18vw] font-bold uppercase leading-none text-white/[0.03] tracking-tighter whitespace-nowrap">
      TRAIL DES MINES
    </div>
  </div>
</footer>

---
const groups = [
  { title: 'Le rendez-vous', links: [['Accueil', '/'], ['Parcours · à venir', '/parcours']] },
  { title: 'Les souvenirs', links: [['Résultats & médias', '/resultats-medias'], ['Éditions précédentes', '/editions-precedentes']] },
  { title: 'Le collectif', links: [['À propos', '/a-propos'], ['Partenaires', '/partenaires'], ['Contact', '/contact']] },
  { title: 'Informations', links: [['Mentions légales', '/mentions-legales'], ['Confidentialité', '/politique-confidentialite'], ['Accessibilité', '/declaration-accessibilite']] },
];
---
<footer class="bg-[#0a1214] pt-16 md:pt-24 flex flex-col relative z-20 overflow-hidden" role="contentinfo">
  <div class="content-70 mx-auto px-4 mb-12 flex flex-col sm:flex-row items-center justify-between gap-6 pb-8 border-b border-white/10 relative z-10">
    <a href="/" class="flex items-center gap-3 group" aria-label="Accueil Trail des Mines">
      <img src="/medias/Logo.png" alt="" class="h-12 md:h-14 w-auto object-contain" loading="lazy" />
      <div>
        <span class="font-display font-bold text-lg md:text-xl uppercase tracking-widest text-white block">Trail des <span class="text-brand">Mines</span></span>
        <span class="text-[10px] uppercase tracking-widest text-gray-400">16 mai 2027 · Champagney</span>
      </div>
    </a>
    <span class="text-xs uppercase tracking-widest text-gray-300">Une organisation <span class="text-brand block sm:inline mt-1">Run in Champagney</span></span>
  </div>
  <div class="content-70 mx-auto px-4 mb-16 md:mb-24 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12 relative z-10">
    {groups.map(group => (
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-white text-sm md:text-base uppercase tracking-[0.2em] mb-4">{group.title}</h2>
        {group.links.map(([label, href]) => <a href={href} data-open-courses-modal={href === '/parcours' ? true : undefined} aria-haspopup={href === '/parcours' ? 'dialog' : undefined} aria-controls={href === '/parcours' ? 'courses-modal' : undefined} class="text-gray-400 hover:text-brand text-xs uppercase tracking-wider transition-colors">{label}</a>)}
        {group.title === 'Informations' && <button type="button" data-open-privacy-settings class="text-gray-400 hover:text-brand text-xs uppercase tracking-wider text-left transition-colors">Préférences de confidentialité</button>}
        {group.title === 'Le rendez-vous' && <button type="button" data-open-registration-modal class="text-brand hover:text-white text-xs uppercase tracking-wider text-left font-bold transition-colors">S’inscrire</button>}
      </div>
    ))}
  </div>
  <div class="w-full text-center z-10 px-4 mb-4 flex flex-col items-center gap-2">
    <p class="text-gray-400 text-[10px] uppercase tracking-widest">© 2027 Run in Champagney · Tous droits réservés</p>
    <a href="https://redstone-media.fr/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-sm text-gray-300 hover:text-brand underline underline-offset-4 decoration-white/30 hover:decoration-brand transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand">Créé par Redstone Media</a>
  </div>
  <div data-footer-wordmark-stage aria-hidden="true" class="w-full relative translate-y-[28%] md:translate-y-[22%] pointer-events-none select-none text-center overflow-hidden">
    <div data-footer-wordmark class="font-display text-[22vw] md:text-[18vw] font-bold uppercase leading-none text-white/[0.03] tracking-tighter whitespace-nowrap origin-bottom">TRAIL DES MINES</div>
  </div>
</footer>
<script>
  const stage = document.querySelector<HTMLElement>('[data-footer-wordmark-stage]');
  const wordmark = document.querySelector<HTMLElement>('[data-footer-wordmark]');
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (stage && wordmark) {
    let scheduled = false;
    const update = () => {
      scheduled = false;
      if (preference.matches) { wordmark.style.transform = ''; return; }
      const rect = stage.getBoundingClientRect();
      const visible = window.innerHeight - rect.top;
      const distanceToEnd = Math.max(0, document.documentElement.scrollHeight - window.innerHeight - window.scrollY);
      const progress = Math.max(0, Math.min(1, visible / Math.max(1, visible + distanceToEnd)));
      const eased = progress * progress * (3 - 2 * progress);
      wordmark.style.transform = `scale(${0.55 + eased * 0.45})`;
    };
    const schedule = () => { if (!scheduled) { scheduled = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    preference.addEventListener('change', schedule);
    document.fonts.ready.then(schedule);
    update();
  }
</script>

<dialog id="courses-modal" aria-labelledby="courses-modal-title" aria-describedby="courses-modal-description">
  <button type="button" class="courses-modal-dismiss" aria-label="Fermer la fenêtre des parcours"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button>
  <h2 id="courses-modal-title">Parcours à venir</h2>
  <p id="courses-modal-description">Les parcours du Trail des Mines 2027 sont en préparation. On vous dévoile les tracés très bientôt.</p>
  <p class="courses-modal-date">Rendez-vous le 16 mai 2027 à Champagney.</p>
  <button type="button" class="courses-modal-close">À très bientôt sur les sentiers</button>
</dialog>
<style>
  dialog { position: fixed; inset: 0; margin: auto; width: min(32rem, calc(100% - 2rem)); max-height: 90svh; overflow-y: auto; border: 0; border-radius: 1.5rem; padding: 3.5rem 2rem 2rem; background: var(--color-dark); color: white; }
  dialog::backdrop { background: rgb(10 18 20 / 85%); }
  h2 { font-family: var(--font-display); font-size: clamp(1.75rem, 5vw, 2.5rem); line-height: 1.2; text-transform: uppercase; margin-bottom: 1.25rem; }
  p { font-size: 1rem; line-height: 1.65; }
  .courses-modal-date { margin-top: 1rem; color: var(--color-brand); }
  .courses-modal-dismiss { position: absolute; top: .75rem; right: .75rem; width: 2.75rem; height: 2.75rem; border-radius: 50%; }
  .courses-modal-dismiss:hover { background: var(--color-card-bg); }
  .courses-modal-close { display: block; width: 100%; min-height: 3rem; margin-top: 2rem; padding: .875rem 1.25rem; border-radius: 999px; background: var(--color-brand); color: var(--color-dark); font-weight: 700; transition: background-color .2s; }
  .courses-modal-close:hover { background: white; }
</style>
<script is:inline>
  (() => {
    const modal = document.getElementById('courses-modal');
    if (!modal) return;
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || !event.target.closest('[data-open-courses-modal]')) return;
      event.preventDefault();
      window.closeMobileMenu?.();
      if (modal.open) return;
      modal.showModal();
      document.body.classList.add('overflow-hidden');
      window.lenis?.stop();
    });
    modal.querySelectorAll('button').forEach(button => button.addEventListener('click', () => modal.close()));
    modal.addEventListener('close', () => {
      document.body.classList.remove('overflow-hidden');
      window.lenis?.start();
    });
    modal.addEventListener('click', (event) => {
      const bounds = modal.getBoundingClientRect();
      if (event.target === modal && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) modal.close();
    });
  })();
</script>
